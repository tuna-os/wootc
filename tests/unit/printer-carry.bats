#!/usr/bin/env bats
# printer-carry.bats — Phase 3 (wootc-go-native) carries the CUPS queues
# wootc-printer-import added, and its report, to the native disk (SPEC §4.6).
# The importer cannot run there (the native system never mounts Windows), so
# a queue left behind here is a printer the user silently loses at Phase 3.
# The printers.conf fixture is what cupsd 2.4.19 wrote on bluefin:stable.

setup() {
    REPO_ROOT="$(cd "$BATS_TEST_DIRNAME/../.." && pwd)"
    GN="$REPO_ROOT/payload/migration/wootc-go-native"
    TMP="$BATS_TEST_TMPDIR"
    eval "$(sed -n '/^log()/p; /^carry_wootc_printers() {/,/^}/p' "$GN")"
    # No live cupsd: lpstat says the queue is unknown, so nothing waits.
    mkdir -p "$TMP/bin"; printf '#!/bin/sh\nexit 1\n' >"$TMP/bin/lpstat"; chmod +x "$TMP/bin/lpstat"
    PATH="$TMP/bin:$PATH"

    CUPS="$TMP/phase2/cups"; NETC="$TMP/native/etc"; NVAR="$TMP/native/var"
    mkdir -p "$CUPS/ppd" "$NETC/cups/ppd" "$NVAR"
    : >"$NETC/cups/printers.conf"
    cat >"$CUPS/printers.conf" <<'EOF'
# Printer configuration file for CUPS v2.4.19
# Written by cupsd
# DO NOT EDIT THIS FILE WHEN CUPSD IS RUNNING
NextPrinterId 3
<Printer Mine>
PrinterId 2
DeviceURI ipp://10.1.1.1/ipp/print
State Idle
Accepting Yes
</Printer>
<DefaultPrinter Office_Laser_5eed>
PrinterId 1
UUID urn:uuid:fd238905-88ff-3aad-5acf-687e6c206ba7
Info Office_Laser_5eed
MakeModel IPP Everywhere Responder - IPP Everywhere
DeviceURI ipp://127.0.0.2:631/ipp/print
State Idle
Accepting Yes
Option print-color-mode monochrome
</DefaultPrinter>
EOF
    echo '*PPD-Adobe: "4.3"' >"$CUPS/ppd/Office_Laser_5eed.ppd"
    echo '*PPD-Adobe: "4.3"' >"$CUPS/ppd/Mine.ppd"
    STATE="$TMP/phase2/printers.json"
    cat >"$STATE" <<'EOF'
{"schemaVersion":1,"printers":[
 {"name":"Office Laser 5eed","queue":"Office_Laser_5eed","status":"added","default":true,"uri":"ipp://127.0.0.2:631/ipp/print"},
 {"name":"Lab Printer 5eed","queue":"Lab_Printer_5eed","status":"waiting","default":false,"uri":"ipp://192.0.2.44:631/ipp/print","reason":"no answer"},
 {"name":"Gone 5eed","queue":"Gone_5eed","status":"added","default":false,"uri":"ipp://10.9.9.9:631/ipp/print"},
 {"name":"Microsoft Print to PDF","queue":"Microsoft_Print_to_PDF","status":"not-migrated","default":false,"reason":"Windows-only virtual printer"}]}
EOF
}

@test "the queues wootc added, their PPDs and the report reach the native disk" {
    run carry_wootc_printers "$CUPS" "$STATE" "$NETC" "$NVAR"
    [ "$status" -eq 0 ]
    cmp "$STATE" "$NVAR/lib/wootc/printers.json"
    [ "$(stat -c %a "$NVAR/lib/wootc/printers.json")" = 644 ]
    # The default queue keeps its block, closing tag included, so the native
    # cupsd loads it as the default.
    grep -qx '<DefaultPrinter Office_Laser_5eed>' "$NETC/cups/printers.conf"
    grep -qx '</DefaultPrinter>' "$NETC/cups/printers.conf"
    grep -qx 'DeviceURI ipp://127.0.0.2:631/ipp/print' "$NETC/cups/printers.conf"
    cmp "$CUPS/ppd/Office_Laser_5eed.ppd" "$NETC/cups/ppd/Office_Laser_5eed.ppd"
    [ "$(stat -c %a "$NETC/cups/ppd/Office_Laser_5eed.ppd")" = 640 ]
    [[ "$output" == *"carried printer queue Office_Laser_5eed"* ]]
}

@test "queues wootc did not add stay behind; a queue the user removed stays removed" {
    run carry_wootc_printers "$CUPS" "$STATE" "$NETC" "$NVAR"
    [ "$status" -eq 0 ]
    # bats does not fail a test on a bare `! cmd`; count instead.
    [ "$(grep -c 'Mine' "$NETC/cups/printers.conf")" -eq 0 ]
    [ ! -e "$NETC/cups/ppd/Mine.ppd" ]
    [ "$(grep -c 'Gone_5eed' "$NETC/cups/printers.conf")" -eq 0 ]
    [ "$(grep -c 'Lab_Printer_5eed' "$NETC/cups/printers.conf")" -eq 0 ]
    [ "$(grep -c '^<[A-Z]' "$NETC/cups/printers.conf")" -eq 1 ]
}

@test "running twice does not duplicate a queue" {
    carry_wootc_printers "$CUPS" "$STATE" "$NETC" "$NVAR"
    carry_wootc_printers "$CUPS" "$STATE" "$NETC" "$NVAR"
    [ "$(grep -c '^<DefaultPrinter Office_Laser_5eed>$' "$NETC/cups/printers.conf")" -eq 1 ]
}

@test "a native system that already has a default keeps it" {
    printf '<DefaultPrinter Native>\nDeviceURI ipp://n/ipp/print\n</DefaultPrinter>\n' >"$NETC/cups/printers.conf"
    carry_wootc_printers "$CUPS" "$STATE" "$NETC" "$NVAR"
    [ "$(grep -c '^<DefaultPrinter ' "$NETC/cups/printers.conf")" -eq 1 ]
    grep -qx '<Printer Office_Laser_5eed>' "$NETC/cups/printers.conf"
    grep -qx '</Printer>' "$NETC/cups/printers.conf"
}

@test "no report, nothing carried and nothing fails" {
    run carry_wootc_printers "$CUPS" "$TMP/absent.json" "$NETC" "$NVAR"
    [ "$status" -eq 0 ]
    [ ! -s "$NETC/cups/printers.conf" ]
    [ ! -e "$NVAR/lib/wootc/printers.json" ]
}

@test "graduate_to_disk_execute calls the carry with the native etc and var" {
    # shellcheck disable=SC2016  # the literal $etcroot/$nvar in the source
    grep -qE '^\s*carry_wootc_printers /etc/cups /var/lib/wootc/printers.json "\$etcroot" "\$nvar"' "$GN"
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <NativeBrandId Condition="'$(NativeBrandId)' == ''">wootc</NativeBrandId>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.cs refuses an unsupported Windows before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="../Wootc.Shell.Core/Wootc.Shell.Core.csproj" />
    <ProjectReference Include="../Wootc.Shell.Native/Wootc.Shell.Native.csproj" />
    <Compile Remove="Engine/Dto.cs" />
    <Content Include="../../app/branding/$(NativeBrandId)/brand.json" Link="Branding/brand.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The same mark the Wails build of this brand embeds; no new asset. -->
    <Content Include="../../app/branding/$(NativeBrandId)/logo.svg" Link="Branding/logo.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../app/branding/$(NativeBrandId)/logo.svg')" />
  </ItemGroup>
  <!-- Unpackaged MRT Core currently generates the app PRI without publishing it.
       Keep the generated resource index beside the executable, not only SDK PRIs. -->
  <Target Name="PublishNativePreviewResourceIndex"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The native preview resource index was not generated." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>

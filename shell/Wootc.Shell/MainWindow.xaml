<Window x:Class="Wootc.Shell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="BrandRoot" Padding="32">
  <Border x:Name="BrandCard" CornerRadius="8" Padding="24" MaxWidth="680" HorizontalAlignment="Left" VerticalAlignment="Top">
  <StackPanel Spacing="18">
    <StackPanel Orientation="Horizontal" Spacing="16">
      <Image x:Name="BrandLogo" AutomationProperties.AutomationId="BrandLogo" Height="56" MaxWidth="96" Visibility="Collapsed" />
      <TextBlock x:Name="BrandEmoji" AutomationProperties.AutomationId="BrandEmoji" FontSize="40" VerticalAlignment="Center" Visibility="Collapsed" />
      <StackPanel VerticalAlignment="Center" Spacing="4">
        <TextBlock x:Name="ProductName" AutomationProperties.AutomationId="ProductName" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="DistributionName" AutomationProperties.AutomationId="DistributionName" />
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="PreviewHeading" Text="Native installer preview" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="PreviewIntro" Text="Review your computer before installing Linux." TextWrapping="Wrap" />
    <TextBlock x:Name="PreviewStatus" Text="This preview can read startup status through the authenticated engine. It cannot install Linux or change storage." TextWrapping="Wrap" AutomationProperties.AutomationId="PreviewStatus" />
    <TextBlock x:Name="ConnectionStatus" Text="Offline" AutomationProperties.AutomationId="ConnectionStatus" TextWrapping="Wrap" />
    <TextBlock x:Name="StartupRouteText" Text="Startup status has not been read" AutomationProperties.AutomationId="StartupRoute" TextWrapping="Wrap" />
    <TextBlock x:Name="StartupObservations" Text="No authenticated startup observations" AutomationProperties.AutomationId="StartupObservations" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button x:Name="ConnectButton" Style="{StaticResource AccentButtonStyle}" Content="Read startup status" Click="Connect_Click" AutomationProperties.AutomationId="ConnectEngine" />
      <Button x:Name="DisconnectButton" Content="Disconnect engine" Click="Disconnect_Click" IsEnabled="False" AutomationProperties.AutomationId="DisconnectEngine" />
    </StackPanel>
  </StackPanel>
  </Border>
  </Grid>
</Window>

<Window x:Class="Wootc.Shell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32"><StackPanel Spacing="18" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock x:Name="ProductName" AutomationProperties.AutomationId="ProductName" Style="{StaticResource TitleTextBlockStyle}" />
    <TextBlock x:Name="DistributionName" AutomationProperties.AutomationId="DistributionName" />
    <TextBlock Text="Native installer preview" Style="{StaticResource SubtitleTextBlockStyle}" />
    <TextBlock Text="Review your computer before installing Linux." TextWrapping="Wrap" />
    <TextBlock Text="The authenticated engine connection is being implemented. This preview cannot install or change your computer." TextWrapping="Wrap" AutomationProperties.AutomationId="PreviewStatus" />
  </StackPanel></Grid>
</Window>

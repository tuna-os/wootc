#!/bin/bash
# Detect Windows libraries without modifying them. Existing Linux VDF metadata
# is preserved; unregistered paths require Steam's Settings > Storage > Add Library.
# Optional <winuser> <linuxuser> restricts an external import to its target user.
set -Eeuo pipefail
base="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
for library in "$base/lib/wootc_import_safety.py" \
    "$base/../lib/wootc/wootc_import_safety.py" \
    /usr/lib/wootc/migration/lib/wootc_import_safety.py; do
    if [[ -f "$library" ]]; then
        exec python3 "$library" steam "$@"
    fi
done
printf '%s\n' '[wootc-steam-bridge] ERROR: safe import library is not installed' >&2
exit 1

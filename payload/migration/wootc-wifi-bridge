#!/bin/bash
# /usr/local/bin/wootc-wifi-bridge [export-dir]
# Wi-Fi migration (SPEC §4.6): convert Windows-exported Wi-Fi profiles into
# NetworkManager connections so the user is online on first Linux boot without
# re-typing passwords.
#
# The Windows installer exports selected saved profiles with
#   netsh wlan export profile key=clear folder=<dir>
# (admin-only; the key is in cleartext in the XML). This reads those XMLs,
# writes NetworkManager keyfile connections, and SHREDS the transient export.
#
# Consent tiers (§4.6):
#   Auto-import : open networks and personal WPA-PSK / WPA3-SAE.
#   Detect only : enterprise 802.1X/EAP, captive portals, cert-based — reported
#                 for the dashboard, never copied (secrets + identity material).
#
# Env: WOOTC_WIFI_SRC (export dir, default /run/wootc/host/wootc/install/wifi),
#      WOOTC_WIFI_DST (NM dir, default /etc/NetworkManager/system-connections),
#      WOOTC_WIFI_ORIGIN (optional: the Windows-side export the deployer
#      staged SRC from — <storage>\wootc\install\wifi on the NTFS volume.
#      It holds the same cleartext keys and is destroyed with SRC).

set -Eeuo pipefail
log() { printf '[wootc-wifi-bridge] %s\n' "$*"; }

SRC="${1:-${WOOTC_WIFI_SRC:-/run/wootc/host/wootc/install/wifi}}"
ORIGIN="${WOOTC_WIFI_ORIGIN:-}"

# Securely destroy a cleartext export (SPEC §4.6: removed right after import).
destroy_export() {
    [[ -n "$1" && -d "$1" ]] || return 0
    find "$1" -maxdepth 1 -name '*.xml' -exec shred -u {} + 2>/dev/null \
        || rm -f "$1"/*.xml 2>/dev/null || true
    rmdir "$1" 2>/dev/null || true
}
# Both exports go when this script ends, however it ends: a profile that
# stops the import must not leave every passphrase behind in clear.
trap 'destroy_export "$SRC"; destroy_export "$ORIGIN"' EXIT

# keyfile_name <ssid> — the file name of the connection. An SSID is up to 32
# bytes chosen by whoever ran the access point, and the file name is the one
# place it is used as a path: '/' and control characters become '_' and
# leading dots go, so the name stays one visible component of DST. The id=
# and ssid= lines in the file keep the SSID as it is. Prints nothing when no
# usable character is left.
keyfile_name() {
    local name="${1//\//_}"
    name="${name//[[:cntrl:]]/_}"
    while [[ "$name" == .* ]]; do name="${name#.}"; done
    printf '%s' "$name"
}
DST="${WOOTC_WIFI_DST:-/etc/NetworkManager/system-connections}"
STATE_DIR="${WOOTC_WIFI_STATE:-/var/lib/wootc}"

[[ -d "$SRC" ]] || { log "no Wi-Fi export at $SRC — nothing to import"; exit 0; }

# Respect the migration chooser. This runs as a system service, so consult the
# first real (uid>=1000) user's selection — the person doing the migration.
if command -v wootc-selection >/dev/null 2>&1; then
    _u=$(awk -F: '$3>=1000 && $3<65534 {print $1; exit}' /etc/passwd 2>/dev/null)
    _sel_rc=0
    [[ -n "$_u" ]] && { wootc-selection "$_u" wifi >/dev/null 2>&1 || _sel_rc=$?; }
    # rc 1 = the user turned it off. Anything else (helper missing/unrunnable)
    # fails OPEN: never silently drop a migration because a helper broke.
    if [ "$_sel_rc" -eq 1 ]; then
        log "wifi: skipped (turned off in the migration chooser)"
        # Opting out of the import is not consent to keep the keys on disk.
        destroy_export "$SRC"
        destroy_export "$ORIGIN"
        exit 0
    fi
fi
mkdir -p "$DST" "$STATE_DIR"

imported=(); skipped=()

for xml in "$SRC"/*.xml; do
    [[ -f "$xml" ]] || continue
    # Parse the netsh profile with python (namespaced XML).
    parsed=$(WIFI_XML="$xml" python3 - <<'PYEOF' || true
import os, sys, xml.etree.ElementTree as ET
try:
    t = ET.parse(os.environ["WIFI_XML"]); r = t.getroot()
except Exception:
    sys.exit(0)
ns = {"w": r.tag.split("}")[0].strip("{")} if "}" in r.tag else {}
def find(path):
    e = r.find(path, ns) if ns else r.find(path)
    return e.text.strip() if e is not None and e.text else ""
ssid = find(".//w:SSIDConfig/w:SSID/w:name") or find(".//w:name")
auth = find(".//w:authEncryption/w:authentication")
key  = find(".//w:sharedKey/w:keyMaterial")
onex = r.find(".//w:MSM/w:security/w:OneX", ns) if ns else r.find(".//OneX")
enterprise = onex is not None or auth in ("WPA2", "WPA", "WPA3", "WPA3ENT")
# Join on the unit separator (0x1f), NOT a tab: tab is IFS-whitespace, so a
# `read` split would collapse an empty middle field (a keyless profile) and
# shift `tier` into `key` — writing a garbage psk instead of skipping.
print("\x1f".join([ssid, auth, key, "ent" if enterprise else "psk"]))
PYEOF
)
    [[ -n "$parsed" ]] || continue
    IFS=$'\x1f' read -r ssid auth key tier <<<"$parsed"
    [[ -n "$ssid" ]] || continue

    # Map Windows auth → NetworkManager key-mgmt.
    keymgmt=""; case "$auth" in
        open|OPEN|"") keymgmt="none" ;;
        WPA2PSK|WPAPSK) keymgmt="wpa-psk" ;;
        WPA3SAE|SAE) keymgmt="sae" ;;
        *) keymgmt="" ;;
    esac
    if [[ "$tier" == "ent" || -z "$keymgmt" ]]; then
        if [[ -n "${_u:-}" ]] && command -v wootc-selection >/dev/null 2>&1; then
            wootc-selection "$_u" wifi wifi-enterprise >/dev/null 2>&1 || {
                [[ "$?" -eq 1 ]] && { skipped+=("$ssid"); log "item skipped by chooser: $ssid"; continue; }
            }
        fi
        skipped+=("$ssid"); log "detected (not copied — enterprise/unknown): $ssid"
        continue
    fi
    if [[ "$keymgmt" != "none" && -z "$key" ]]; then
        skipped+=("$ssid"); log "detected (no cleartext key): $ssid"; continue
    fi
	if [[ -n "${_u:-}" ]] && command -v wootc-selection >/dev/null 2>&1; then
		wootc-selection "$_u" wifi wifi-importable >/dev/null 2>&1 || {
			[[ "$?" -eq 1 ]] && { skipped+=("$ssid"); log "item skipped by chooser: $ssid"; continue; }
		}
	fi

    # Write the NetworkManager keyfile connection.
    uuid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || python3 -c 'import uuid;print(uuid.uuid4())')
    name=$(keyfile_name "$ssid")
    dst="$DST/${name:-$uuid}.nmconnection"
    if [[ -e "$dst" ]]; then log "exists, skipping: $ssid"; continue; fi
    # No `if ! { … } > file`: bash does not negate a group whose redirection
    # failed, so the failure branch is the else.
    if {
        printf '[connection]\nid=%s\nuuid=%s\ntype=wifi\n\n' "$ssid" "$uuid"
        printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$ssid"
        if [[ "$keymgmt" != "none" ]]; then
            printf '[wifi-security]\nkey-mgmt=%s\npsk=%s\n\n' "$keymgmt" "$key"
        fi
        printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
    } > "$dst"; then
        chmod 600 "$dst"; chown root:root "$dst" 2>/dev/null || true
        imported+=("$ssid")
        log "imported: $ssid ($keymgmt)"
    else
        # One network that cannot be written must not cost the others.
        rm -f "$dst"
        skipped+=("$ssid"); log "could not write the connection, skipped: $ssid"
    fi
done

# Securely destroy the transient cleartext export, and the Windows-side copy
# it was staged from: both hold every passphrase in clear. Here, not only in
# the EXIT trap, so the keys are gone before NetworkManager is asked to reload.
destroy_export "$SRC"
destroy_export "$ORIGIN"

# Ask NetworkManager to pick up the new connections (best-effort).
command -v nmcli >/dev/null && nmcli connection reload 2>/dev/null || true

# Dashboard state.
{
    printf '{\n  "imported": %d,\n  "skippedEnterprise": %d,\n' "${#imported[@]}" "${#skipped[@]}"
    printf '  "note": "Open and personal Wi-Fi moved. Enterprise/802.1X networks were detected but need a fresh sign-in in Settings."\n}\n'
} > "$STATE_DIR/wifi-bridge.json"
log "done: ${#imported[@]} imported, ${#skipped[@]} left for manual sign-in"

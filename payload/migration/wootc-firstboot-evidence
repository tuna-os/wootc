#!/usr/bin/env bash
# wootc-firstboot-evidence — Phase-2 first-boot evidence and health marker.
#
# Runs as wootc-firstboot-evidence.service on the first successful boot into
# Phase-2 Linux. Measures that boot (kernel, booted image and digest, decoded
# BootCurrent, root.disk identity, User Data Bridge, Secure Boot) against the
# installation Windows staged, writes the measurement to
# \wootc\install\installed-linux-boot.json, updates state.json on the Windows
# host NTFS to "healthy", publishes the control panels' summary and finally
# writes installed-linux-boot.complete, which stops the unit from running
# again. Windows cross-checks the record against its own record of the
# install before it reports "healthy".
#
# The evidence is written once per installation: an existing record of this
# installation is never replaced, so a later boot cannot rewrite what the
# first one measured. The
# record carries the kernel boot ID and a sequence number.
#
# Contract: docs/borrowed-from-libertix.md §2, §3

set -euo pipefail

# shellcheck source=payload/steps.sh
source "${WOOTC_STEPS_FILE:-/var/usrlocal/lib/wootc/steps.sh}"

HOST="${WOOTC_FIRSTBOOT_HOST:-/run/initramfs/wootc-host}"

INSTALL_DIR="$HOST/wootc/install"
EVIDENCE_FINAL="$INSTALL_DIR/installed-linux-boot.json"
STATE_FINAL="$HOST/wootc/state.json"
COLLECTOR="${WOOTC_FIRSTBOOT_COLLECTOR:-/var/usrlocal/lib/wootc/wootc_firstboot_evidence.py}"

log() {
    local message="[wootc-firstboot] $*"
    printf '%s\n' "$message"
    printf '%s\n' "$message" > /dev/console 2>/dev/null || true
    printf '<27>%s\n' "$message" > /dev/kmsg 2>/dev/null || true
}

on_error() {
    local rc="$1" line="$2" command="$3"
    log "ERROR: first-boot state write failed at line $line (exit $rc): $command"
    exit "$rc"
}

# The ERR trap supplies failed_command and failed_line before on_error runs.
# shellcheck disable=SC2154
trap 'rc=$?; failed_command=$BASH_COMMAND; failed_line=$LINENO; trap - ERR; on_error "$rc" "$failed_line" "$failed_command"' ERR

if ! mountpoint -q "$HOST"; then
    log "ERROR: $HOST is not mounted (wootc-host-bind.service did not run first)"
    exit 1
fi

[[ $(wootc_step_owner firstboot-evidence) == firstboot ]]
log "phase: firstboot-evidence"
log "$(wootc_step_label firstboot-evidence)"

# Windows created this directory with its own ACL. A directory made here
# would carry a Linux-side descriptor that Windows refuses to trust.
if [[ ! -d "$INSTALL_DIR" || -L "$INSTALL_DIR" ]]; then
    log "ERROR: $INSTALL_DIR is missing; the Windows install record is not on this volume"
    exit 1
fi

EVIDENCE_TEMP=$(mktemp)
trap 'rm -f "$EVIDENCE_TEMP"' EXIT
RECORDED=absent
if [[ -e "$EVIDENCE_FINAL" || -L "$EVIDENCE_FINAL" ]]; then
    # Never re-measure or replace what an earlier boot of THIS installation
    # recorded. A record without the completion marker is an interrupted
    # publication: finish it from that record, but only when this collector
    # wrote it. A record naming another installation (Windows keeps the old
    # one for diagnosis when it arms a new attempt) is measured anew.
    RECORDED=kept
    if [[ ! -L "$EVIDENCE_FINAL" ]]; then
        rc=0
        python3 - "$EVIDENCE_FINAL" "$INSTALL_DIR/installation.json" > "$EVIDENCE_TEMP" <<'PYTHON' || rc=$?
import json
import sys


def load(path):
    with open(path, 'rb') as stream:
        data = stream.read(65537)
    if len(data) > 65536:
        raise ValueError('oversized record')
    return data.decode('utf-8-sig'), json.loads(data.decode('utf-8-sig'))


try:
    text, record = load(sys.argv[1])
except (OSError, ValueError):
    sys.exit(1)
if not (isinstance(record, dict) and record.get('state') == 'healthy'
        and record.get('updatedBy') == 'wootc-firstboot'):
    sys.exit(1)
try:
    _, plan = load(sys.argv[2])
    current = plan.get('installationId') if isinstance(plan, dict) else None
except (OSError, ValueError):
    current = None
if current and record.get('installationId') != current:
    sys.exit(3)
sys.stdout.write(text)
PYTHON
        case "$rc" in
            0) RECORDED=resume ;;
            3) RECORDED=stale ;;
        esac
    fi
    if [[ "$RECORDED" == kept ]]; then
        log "first-boot evidence already recorded; leaving it unchanged"
        exit 0
    fi
    if [[ "$RECORDED" == resume ]]; then
        log "first-boot evidence already recorded; completing its publication"
    else
        log "first-boot evidence names a previous installation; measuring this one"
    fi
fi
if [[ "$RECORDED" != resume ]]; then
    # Measure before writing anything. A boot that cannot be measured must not
    # announce itself healthy; the unit runs again on the next boot. The
    # collector refuses a boot of another installation, ESP, image, Windows
    # volume or root.disk.
    if ! python3 "$COLLECTOR" --host "$HOST" > "$EVIDENCE_TEMP"; then
        log "ERROR: could not measure this boot; first-boot evidence not written"
        exit 1
    fi
    # The helper preserves the Windows ACL and atomically replaces the record
    # on the NTFS volume (temporary file, then rename).
    wootc-ntfs-state-write "$STATE_FINAL" "$EVIDENCE_FINAL" < "$EVIDENCE_TEMP"
fi

# Publish evidence before healthy. Only the final completion marker suppresses
# retries, so a failed descriptor-preserving state write is retried next boot.
NOW=$(date -u +%FT%TZ)
wootc-ntfs-state-write "$STATE_FINAL" "$STATE_FINAL" <<JSONEOF
{
  "state": "healthy",
  "updatedAt": "$NOW",
  "updatedBy": "wootc-firstboot"
}
JSONEOF
# Publish only the facts useful to the local control panel; the private
# installation ID, paths and profile mappings remain on the protected NTFS tree.
python3 "$COLLECTOR" --publish-summary "$EVIDENCE_TEMP" \
    --summary-dir "${WOOTC_FIRSTBOOT_SUMMARY_DIR:-/var/lib/wootc}"
wootc-ntfs-state-write "$STATE_FINAL" "$INSTALL_DIR/installed-linux-boot.complete" < "$EVIDENCE_TEMP"

KERNEL_VER="$(uname -r 2>/dev/null || echo "unknown")"
log "Phase-2 first-boot health reported: state.json -> healthy ($KERNEL_VER), evidence in installed-linux-boot.json"

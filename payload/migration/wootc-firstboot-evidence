#!/usr/bin/env bash
# wootc-firstboot-evidence — Phase-2 first-boot evidence and health marker.
#
# Runs as wootc-firstboot-evidence.service on the first successful boot into
# Phase-2 Linux. Updates state.json on the Windows host NTFS to "healthy"
# and writes the first-boot evidence file installed-linux-boot.json.
#
# Contract: docs/borrowed-from-libertix.md §2, §3

set -euo pipefail

# shellcheck source=payload/steps.sh
source "${WOOTC_STEPS_FILE:-/var/usrlocal/lib/wootc/steps.sh}"

HOST="${WOOTC_FIRSTBOOT_HOST:-/run/initramfs/wootc-host}"

INSTALL_DIR="$HOST/wootc/install"
EVIDENCE_FINAL="$INSTALL_DIR/installed-linux-boot.json"
STATE_FINAL="$HOST/wootc/state.json"

log() {
    local message="[wootc-firstboot] $*"
    printf '%s\n' "$message"
    printf '%s\n' "$message" > /dev/console 2>/dev/null || true
    printf '<27>%s\n' "$message" > /dev/kmsg 2>/dev/null || true
}

on_error() {
    local rc="$1" line="$2" command="$3"
    log "ERROR: first-boot state write failed at line $line (exit $rc): $command"
    exit "$rc"
}

# The ERR trap supplies failed_command and failed_line before on_error runs.
# shellcheck disable=SC2154
trap 'rc=$?; failed_command=$BASH_COMMAND; failed_line=$LINENO; trap - ERR; on_error "$rc" "$failed_line" "$failed_command"' ERR

if ! mountpoint -q "$HOST"; then
    log "ERROR: $HOST is not mounted (wootc-host-bind.service did not run first)"
    exit 1
fi

[[ $(wootc_step_owner firstboot-evidence) == firstboot ]]
log "phase: firstboot-evidence"
log "$(wootc_step_label firstboot-evidence)"

mkdir -p "$INSTALL_DIR"

# Collect every required fact before publishing anything. The collector refuses
# a boot of another ESP, image, Windows volume, or root.disk.
COLLECTOR="${WOOTC_FIRSTBOOT_COLLECTOR:-/var/usrlocal/bin/wootc-collect-firstboot.py}"
EVIDENCE_TEMP=$(mktemp)
trap 'rm -f "$EVIDENCE_TEMP"' EXIT
python3 "$COLLECTOR" --host "$HOST" > "$EVIDENCE_TEMP"
# The catalogue phase describes this observed collection/publication. Add it to
# the verified record; the lifecycle state retains its separate vocabulary.
python3 - "$EVIDENCE_TEMP" <<'PYTHON'
import json
from pathlib import Path
import sys
path = Path(sys.argv[1])
with path.open('rb') as stream:
    data = stream.read(65537)
if len(data) > 65536:
    raise ValueError('first-boot evidence exceeds 64 KiB')
record = json.loads(data)
if not isinstance(record, dict):
    raise ValueError('first-boot evidence must be an object')
record['phaseId'] = 'firstboot-evidence'
data = (json.dumps(record, indent=2) + '\n').encode()
if len(data) > 65536:
    raise ValueError('first-boot evidence exceeds 64 KiB after phase annotation')
path.write_bytes(data)
PYTHON

# Publish evidence before healthy. Only the final completion marker suppresses
# retries, so a failed descriptor-preserving state write is retried next boot.
wootc-ntfs-state-write "$STATE_FINAL" "$EVIDENCE_FINAL" < "$EVIDENCE_TEMP"
NOW=$(date -u +%FT%TZ)
wootc-ntfs-state-write "$STATE_FINAL" "$STATE_FINAL" <<JSONEOF
{
  "state": "healthy",
  "updatedAt": "$NOW",
  "updatedBy": "wootc-firstboot"
}
JSONEOF
# Publish only the facts useful to the local control panel; the private
# Windows UUID, paths and profile mappings remain on the protected NTFS tree.
python3 "${WOOTC_FIRSTBOOT_PUBLISHER:-/var/usrlocal/bin/wootc-collect-firstboot.py}" --publish-summary "$EVIDENCE_TEMP" \
    --summary-dir "${WOOTC_FIRSTBOOT_SUMMARY_DIR:-/var/lib/wootc}"
wootc-ntfs-state-write "$STATE_FINAL" "$INSTALL_DIR/installed-linux-boot.complete" < "$EVIDENCE_TEMP"

log "Phase-2 first-boot health reported: evidence verified and state.json -> healthy"

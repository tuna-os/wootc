#!/usr/bin/env bash
# wootc-firstboot-evidence — Phase-2 first-boot evidence and health marker.
#
# Runs as wootc-firstboot-evidence.service on the first successful boot into
# Phase-2 Linux. Updates state.json on the Windows host NTFS to "healthy"
# and writes the first-boot evidence file installed-linux-boot.json.
#
# Contract: docs/borrowed-from-libertix.md §2, §3

set -euo pipefail

HOST="${WOOTC_FIRSTBOOT_HOST:-/run/initramfs/wootc-host}"

INSTALL_DIR="$HOST/wootc/install"
EVIDENCE_FINAL="$INSTALL_DIR/installed-linux-boot.json"
STATE_FINAL="$HOST/wootc/state.json"

log() {
    local message="[wootc-firstboot] $*"
    printf '%s\n' "$message"
    printf '%s\n' "$message" > /dev/console 2>/dev/null || true
    printf '<27>%s\n' "$message" > /dev/kmsg 2>/dev/null || true
}

on_error() {
    local rc="$1" line="$2" command="$3"
    log "ERROR: first-boot state write failed at line $line (exit $rc): $command"
    exit "$rc"
}

# The ERR trap supplies failed_command and failed_line before on_error runs.
# shellcheck disable=SC2154
trap 'rc=$?; failed_command=$BASH_COMMAND; failed_line=$LINENO; trap - ERR; on_error "$rc" "$failed_line" "$failed_command"' ERR

if ! mountpoint -q "$HOST"; then
    log "ERROR: $HOST is not mounted (wootc-host-bind.service did not run first)"
    exit 1
fi

mkdir -p "$INSTALL_DIR"

NOW=$(date -u +%FT%TZ 2>/dev/null || date)
KERNEL_VER="$(uname -r 2>/dev/null || echo "unknown")"

# Update the lifecycle state before the evidence marker. The unit is gated on
# the marker's absence; writing it last lets the service retry after a failed
# state update on the next boot. The helper preserves the Windows ACL and
# atomically replaces each record on the NTFS volume.
wootc-ntfs-state-write "$STATE_FINAL" "$STATE_FINAL" <<JSONEOF
{
  "state": "healthy",
  "updatedAt": "$NOW",
  "updatedBy": "wootc-firstboot"
}
JSONEOF

wootc-ntfs-state-write "$STATE_FINAL" "$EVIDENCE_FINAL" <<JSONEOF
{
  "state": "healthy",
  "kernel": "$KERNEL_VER",
  "writtenAt": "$NOW",
  "updatedBy": "wootc-firstboot"
}
JSONEOF

log "Phase-2 first-boot health reported: state.json -> healthy ($KERNEL_VER)"

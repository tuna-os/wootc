#!/bin/bash
# /usr/local/bin/wootc-detect-apps <username> [linuxuser]
# /usr/local/bin/wootc-detect-apps --detect-browsers [username]
# App-data bridge: scan the Windows profile, copy portable non-browser
# app data, and record per-app session portability for the dashboard.
# --detect-browsers is the authoritative, read-only browser plugin detector.
#
# Session portability ground truth:
#   PORTABLE      — plain-file state: Firefox (whole profile incl. logins),
#                   VS Code (settings/keybindings/snippets + extension list).
#   STAGED        — Windows export evidence only; Linux import is unverified.
#   SIGNIN        — Chromium/Electron state is machine-bound without a
#                   verified target import. Source exports.json cannot prove
#                   that Linux is signed in, even if it says "imported".
#
# The APP DATABASE below is the extension point: one entry per app —
# detect path, flatpak id, portable copy function (optional), session
# note. Output: ~/.config/wootc/bridge-apps.json for the dashboard, and
# /run/wootc-detected-flatpaks (newline list) for the deployer to merge
# into the fisherman recipe when run at deploy time.

set -Eeuo pipefail
HOST="${WOOTC_HOST:-/run/wootc/host}"
log() { printf '[wootc-detect-apps] %s\n' "$*"; }
read_only=false
if [[ "${1:-}" == "--detect-browsers" ]]; then
    read_only=true
    shift
fi
name="${1:-${WOOTC_WIN_USER:-}}"
if ! "$read_only"; then
    : "${name:?usage: wootc-detect-apps <username> [linuxuser]}"
fi
target="${2:-$name}"
W="$HOST/Users/$name"
if "$read_only"; then
    W="${WOOTC_WIN_USER_DIR:-$W}"
fi

entries=()
flatpaks=()

# add <app> <flatpak> <session:portable|staged|signin|relink|none> <copied:true|false> <note>
add() {
    entries+=("$(python3 -c '
import json, sys
app, flatpak, session, copied, note = sys.argv[1:]
print(json.dumps(dict(app=app, flatpak=flatpak, session=session, copied=copied == "true", note=note), separators=(",", ":")))
' "$@")")
    [[ -n "$2" ]] && flatpaks+=("$2")
}

# Source exports describe staging only, never successful target authentication.
EXPORTS_JSON=""
for p in "$HOST"/wootc/install/slurp/session/exports.json "$HOST"/install/slurp/session/exports.json; do
    if [[ -f "$p" ]]; then
        EXPORTS_JSON="$p"
        break
    fi
done

session_state() {
    local app="$1"
    [[ -n "$EXPORTS_JSON" ]] || { echo "none"; return 0; }
    python3 - "$EXPORTS_JSON" "$app" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        data = json.load(source)
    staged = isinstance(data, list) and any(
        isinstance(entry, dict)
        and entry.get("app") == sys.argv[2]
        and entry.get("state") == "staged"
        for entry in data
    )
except (OSError, ValueError, TypeError):
    staged = False
print("staged" if staged else "none")
PY
}

# Browser detection is shared by this bridge, the browsers plugin, and the
# manifest fallback. It reads metadata only; wootc-import-browser owns copying.
detect_browsers() {
    python3 - "$HOST" "$W" "$(session_state chrome)" "$(session_state edge)" <<'PY'
import json
import os
import sys

host, root, chrome_state, edge_state = sys.argv[1:]
installed = set()
try:
    with open(os.path.join(host, "wootc", "install", "programs.json"), encoding="utf-8") as stream:
        registry = json.load(stream)
    programs = registry.get("apps", []) if isinstance(registry, dict) else []
    for program in programs if isinstance(programs, list) else []:
        name = program.get("displayName", "") if isinstance(program, dict) else ""
        if not isinstance(name, str):
            continue
        for app, marker in (("firefox", "firefox"), ("chrome", "google chrome"), ("edge", "microsoft edge")):
            if marker in name.lower():
                installed.add(app)
except (OSError, ValueError):
    pass
items = []
definitions = (
    ("firefox", "Firefox", "org.mozilla.firefox",
     ("Roaming", "Mozilla", "Firefox"), "portable"),
    ("chrome", "Chrome", "com.google.Chrome",
     ("Local", "Google", "Chrome", "User Data"), chrome_state),
    ("edge", "Edge", "com.google.Chrome",
     ("Local", "Microsoft", "Edge", "User Data"), edge_state),
)
for app, label, flatpak, parts, state in definitions:
    source = os.path.join(root, "AppData", *parts)
    present = (os.path.isfile(os.path.join(source, "profiles.ini"))
               if app == "firefox" else os.path.isdir(source))
    if not present and app not in installed:
        continue
    if not present:
        session = "signin"
        note = "Installed on Windows; no portable browser profile was found at the expected source path."
    elif app == "firefox":
        session = "portable"
        note = "Everything moves: bookmarks, history, passwords, extensions, open tabs."
    elif state == "staged":
        session = "staged"
        note = "Session key staged — you'll sign in once on Linux until target import is verified."
    else:
        session = "signin"
        note = ("Bookmarks and history move. Sign in once and sync brings the rest."
                if app == "chrome" else
                "Bookmarks and history move into Chrome. Passwords need a fresh sign-in.")
    count = size = 0
    for directory, directories, files in os.walk(source):
        directories.sort()
        for filename in sorted(files):
            count += 1
            try:
                size += os.path.getsize(os.path.join(directory, filename))
            except OSError:
                pass
            if count >= 50000:
                break
        if count >= 50000:
            break
    items.append({
        "id": app, "app": app, "label": label, "flatpak": flatpak,
        "session": session, "copied": False, "note": note, "detail": note,
        "source": source, "fileCount": count, "sizeBytes": size,
        "evidence": "profile" if present else "registry",
    })
print(json.dumps({
    "detected": bool(items), "items": items,
    "summary": ", ".join(item["label"] for item in items),
}))
PY
}

if "$read_only"; then
    detect_browsers
    exit 0
fi

mountpoint -q "$HOST" || { log "ERROR: $HOST not mounted"; exit 1; }
passwd_record=$(getent passwd "$target")
IFS=: read -r _ _ target_uid target_gid _ home _ <<< "$passwd_record"
[[ "$target_uid" =~ ^[0-9]+$ && "$target_gid" =~ ^[0-9]+$ ]] || { log "ERROR: invalid target account"; exit 1; }
[[ -d "$home" ]] || { log "ERROR: no home for $name"; exit 1; }

# ── APP DATABASE ────────────────────────────────────────────────────────────
browser_json=$(detect_browsers)
while IFS=$'\t' read -r flatpak entry; do
    entries+=("$entry")
    flatpaks+=("$flatpak")
done < <(python3 -c '
import json, sys
for item in json.load(sys.stdin)["items"]:
    entry = {key: item[key] for key in ("app", "flatpak", "session", "copied", "note", "source")}
    print(item["flatpak"] + "\t" + json.dumps(entry, separators=(",", ":")))
' <<< "$browser_json")

# VS Code — settings/keybindings/snippets + extension list are plain files.
VSC="$W/AppData/Roaming/Code/User"
if [[ -d "$VSC" ]]; then
    add vscode com.visualstudio.code portable false \
        "Portable settings, snippets and extension inventory are available; native files will be preserved."
fi

# Discord — Electron safeStorage; nothing offline-portable.
[[ -d "$W/AppData/Roaming/discord" ]] && \
    add discord com.discordapp.Discord signin false \
        "Your servers and messages live in your account — sign in once and everything is back."

# Spotify — credentials are machine-bound; library is cloud-side anyway.
if [[ -d "$W/AppData/Roaming/Spotify" || -d "$W/AppData/Local/Packages/SpotifyAB.SpotifyMusic_zpdnekdrzrea0" ]]; then
    s_state=$(session_state "spotify")
    if [[ "$s_state" == "staged" ]]; then
        add spotify com.spotify.Client staged false "Session key staged — you'll sign in once on Linux until target import is verified."
    else
        add spotify com.spotify.Client signin false "Playlists and library are in your account — sign in once."
    fi
fi

# Slack / Teams — Electron, same story.
[[ -d "$W/AppData/Roaming/Slack" ]] && \
    add slack com.slack.Slack signin false "Workspaces return on sign-in."

# Steam — handled by wootc-steam-bridge (games in place); note here for
# the dashboard's app list completeness.
[[ -d "$HOST/Program Files (x86)/Steam" ]] && \
    add steam com.valvesoftware.Steam signin false \
        "Your game files are already bridged — sign in once and they are playable without re-download."

# Telegram Desktop — copy session files only into a new destination; the
# application must verify or relink the account after the copy.
TG="$W/AppData/Roaming/Telegram Desktop/tdata"
if [[ -d "$TG" ]]; then
    add telegram org.telegram.desktop portable false \
        "Session files are available; an existing Linux Telegram profile will be preserved."
fi

# Signal Desktop — phone-linked app; guided re-link flow.
SG="$W/AppData/Roaming/Signal"
if [[ -d "$SG" ]]; then
    add signal org.signal.Signal relink false \
        "Legacy unencrypted profiles can be copied into a new destination; otherwise re-link with your phone."
fi

# WhatsApp — Store/UWP app; guided web re-link flow.
[[ -d "$W/AppData/Local/Packages" ]] && ls "$W/AppData/Local/Packages" 2>/dev/null | grep -qi whatsapp && \
    add whatsapp "" relink false \
        "No official Linux app. Open web.whatsapp.com and scan the QR with Linked Devices."

# Thunderbird — profiles are portable like Firefox's.
TB="$W/AppData/Roaming/Thunderbird"
if [[ -f "$TB/profiles.ini" ]]; then
    add thunderbird org.mozilla.Thunderbird portable false \
        "Mail profile is available; an existing Linux Thunderbird profile will be preserved."
fi

# Zoom — cloud account; nothing portable.
[[ -d "$W/AppData/Roaming/Zoom" ]] && \
    add zoom us.zoom.Zoom signin false "Sign in once; meetings and settings are account-side."

# ── Wider catalog (detect → auto-install the Flathub equivalent) ────────────
# These add the matching Flatpak to the deploy so the user's apps are already
# there on first boot. We deliberately DON'T auto-copy their config here (that
# is per-app fragile); creative apps keep plain-file settings the user can
# bring over by hand, which the note says honestly. Flathub IDs are public
# facts — this list is wootc's own, grown against the field (incl. what peer
# projects like Operese cover), never lifted from AGPL code.

# Creative / media — plain-file settings, so genuinely portable by hand.
[[ -d "$W/AppData/Roaming/GIMP" ]] && \
    add gimp org.gimp.GIMP portable false "Installs on Linux; your brushes and settings under AppData\\Roaming\\GIMP can be copied over."
[[ -d "$W/AppData/Roaming/krita" ]] && \
    add krita org.kde.krita portable false "Installs on Linux; brushes and configs are plain files you can bring across."
[[ -d "$W/AppData/Roaming/inkscape" ]] && \
    add inkscape org.inkscape.Inkscape portable false "Installs on Linux; preferences are plain files."
[[ -d "$W/AppData/Roaming/Blender Foundation/Blender" ]] && \
    add blender org.blender.Blender portable false "Installs on Linux; your Blender config folder copies straight over."
[[ -d "$W/AppData/Roaming/audacity" ]] && \
    add audacity org.audacityteam.Audacity portable false "Installs on Linux; settings are plain files."
[[ -d "$W/AppData/Roaming/vlc" ]] && \
    add vlc org.videolan.VLC portable false "Installs on Linux; playlists and settings can be copied."
[[ -d "$W/AppData/Roaming/HandBrake" ]] && \
    add handbrake fr.handbrake.ghb portable false "Installs on Linux; your presets can be exported/imported."
[[ -d "$W/AppData/Roaming/qBittorrent" ]] && \
    add qbittorrent org.qbittorrent.qBittorrent portable false "Installs on Linux; settings are plain files."

# Comms / accounts — everything lives in the account, so a sign-in restores it.
[[ -d "$W/AppData/Roaming/Element" ]] && \
    add element im.riot.Riot signin false "Installs on Linux; sign in and your rooms are back."
[[ -d "$W/AppData/Roaming/Bitwarden" ]] && \
    add bitwarden com.bitwarden.desktop signin false "Installs on Linux; unlock with your account — the vault is server-side."
[[ -d "$W/AppData/Local/BraveSoftware/Brave-Browser/User Data" ]] && \
    add brave com.brave.Browser signin false "Installs on Linux; sign in to Brave Sync to bring bookmarks and passwords."
[[ -d "$W/AppData/Roaming/vivaldi" || -d "$W/AppData/Local/Vivaldi/User Data" ]] && \
    add vivaldi com.vivaldi.Vivaldi signin false "Installs on Linux; sign in to Vivaldi to sync your data."

# OBS — plain-file scenes/profiles are portable.
OBS="$W/AppData/Roaming/obs-studio"
if [[ -d "$OBS" ]]; then
    add obs com.obsproject.Studio portable false \
        "Scenes and profiles are available; existing Linux OBS settings will be preserved."
fi

# ── Registry union (SPEC §4.3) ─────────────────────────────────────────────
# wootc.exe (Phase 1) writes C:\wootc\install\programs.json from the
# Windows uninstall registry keys. Merge it here so the dashboard reflects
# the complete installed-program inventory, not just what happens to have
# an AppData footprint. Registry-discovered apps get "signin" portability:
# they exist on the machine and get a Flatpak, but we make no claim about
# portable data unless the AppData scan already handled them.

# nameFromRegistry maps a registry DisplayName to our app key. The
# matching is case-insensitive substring: the DisplayName is lowercased
# and we search for the substring. The table is wootc's own, grown against
# the field (public Flathub IDs), not lifted from any AGPL code.
declare -A DISPLAYNAME_TO_APP=(
    # Other browsers; Firefox/Chrome/Edge registry detection is shared above.
    ["brave"]="brave|com.brave.Browser|signin|false|Installed on Windows. Sign in to Brave Sync."
    ["vivaldi"]="vivaldi|com.vivaldi.Vivaldi|signin|false|Installed on Windows. Sign in to Vivaldi to sync."
    ["opera"]="opera|com.opera.Opera|signin|false|Installed on Windows. Sign in to Opera to sync."

    # Creative / media
    ["gimp"]="gimp|org.gimp.GIMP|portable|false|Installed on Windows. Brushes and settings can be copied from AppData."
    ["krita"]="krita|org.kde.krita|portable|false|Installed on Windows. Brushes and configs are plain files."
    ["inkscape"]="inkscape|org.inkscape.Inkscape|portable|false|Installed on Windows. Preferences are plain files."
    ["blender"]="blender|org.blender.Blender|portable|false|Installed on Windows. Config folder copies straight over."
    ["audacity"]="audacity|org.audacityteam.Audacity|portable|false|Installed on Windows. Settings are plain files."
    ["vlc media player"]="vlc|org.videolan.VLC|portable|false|Installed on Windows. Playlists and settings can be copied."
    ["handbrake"]="handbrake|fr.handbrake.ghb|portable|false|Installed on Windows. Presets can be exported."
    ["obs studio"]="obs|com.obsproject.Studio|portable|false|Installed on Windows. Scenes and profiles can be copied."
    ["qbittorrent"]="qbittorrent|org.qbittorrent.qBittorrent|portable|false|Installed on Windows. Settings are plain files."

    # Comms
    ["discord"]="discord|com.discordapp.Discord|signin|false|Servers and messages live in your account."
    ["slack"]="slack|com.slack.Slack|signin|false|Workspaces return on sign-in."
    ["spotify"]="spotify|com.spotify.Client|signin|false|Playlists and library are in your account."
    ["telegram desktop"]="telegram|org.telegram.desktop|portable|false|Installed on Windows. Session data can be copied."
    ["signal"]="signal|org.signal.Signal|signin|false|Installed on Windows. Re-link with your phone."
    ["zoom"]="zoom|us.zoom.Zoom|signin|false|Meetings and settings are account-side."
    ["element"]="element|im.riot.Riot|signin|false|Installed on Windows. Sign in and rooms are back."
    ["teams"]="teams|com.microsoft.Teams|signin|false|Installed on Windows. Sign in once."
    ["bitwarden"]="bitwarden|com.bitwarden.desktop|signin|false|Vault is server-side."

    # Dev
    ["visual studio code"]="vscode|com.visualstudio.code|portable|false|Installed on Windows. Settings and keybindings can be copied."
    ["notepad++"]="notepad++|com.notepadqq.Notepadqq|none|false|Notepad++ has no native Linux port; Notepadqq is the closest equivalent."
    ["sublime text"]="sublime|com.sublimetext.three|portable|false|Installed on Windows. Settings are plain files."
    ["git"]="git|org.gnome.gitg|none|false|git is built into Linux; Gitg is a graphical client."

    # Gaming
    ["steam"]="steam|com.valvesoftware.Steam|signin|false|Game files are bridged — sign in once."
    ["epic games launcher"]="epic|com.heroicgameslauncher.hgl|signin|false|Use Heroic Games Launcher to access your Epic library on Linux."
    ["minecraft"]="minecraft|com.mojang.Minecraft|signin|false|Sign in and your Minecraft account is back."

    # Office / productivity
    ["mozilla thunderbird"]="thunderbird|org.mozilla.Thunderbird|portable|false|Installed on Windows. Mail accounts can be copied."
    ["libreoffice"]="libreoffice|org.libreoffice.LibreOffice|portable|false|Installed on Windows. Documents are plain files."
    ["adobe acrobat"]="acrobat|org.gnome.Evince|none|false|Adobe Acrobat has no Linux version. Evince opens PDFs."
    ["adobe reader"]="acrobat|org.gnome.Evince|none|false|Adobe Reader has no Linux version. Evince opens PDFs."
    ["7-zip"]="7zip|org.gnome.FileRoller|none|false|Built into Linux; File Roller handles archives."
    ["winrar"]="7zip|org.gnome.FileRoller|none|false|Built into Linux; File Roller handles archives."
    ["putty"]="putty|org.gnome.Ptyxis|none|false|Linux terminals are built in; Ptyxis is a modern graphical terminal."
)

# Read the Phase-1 registry manifest, if present.
REGJSON="$HOST/wootc/install/programs.json"
if [[ -f "$REGJSON" ]]; then
    # Track which apps we already found via AppData so we don't double-add.
    # We parse the app key out of each JSON entry with a simple sed cut.
    declare -A already_have
    for entry in "${entries[@]}"; do
        app_name=$(echo "$entry" | sed -n 's/.*"app":"\([^"]*\)".*/\1/p')
        [[ -n "$app_name" ]] && already_have["$app_name"]=1
    done

    # Parse DisplayName values from programs.json and match against our table.
    # We use python3 to parse JSON (more reliable than sed/jq guessing);
    # python3 is available on the deployed system (wootc-import also uses it).
    while IFS= read -r display_name; do
        [[ -z "$display_name" ]] && continue
        dnorm=$(echo "$display_name" | tr '[:upper:]' '[:lower:]')

        matched=""
        for key in "${!DISPLAYNAME_TO_APP[@]}"; do
            if [[ "$dnorm" == *"$key"* ]]; then
                matched="$key"
                break
            fi
        done

        if [[ -n "$matched" ]]; then
            IFS='|' read -r app_key flatpak session copied note <<< "${DISPLAYNAME_TO_APP[$matched]}"
            if [[ -z "${already_have[$app_key]:-}" ]]; then
                add "$app_key" "$flatpak" "$session" "$copied" "$note"
                already_have["$app_key"]=1
                log "registry: $display_name → $app_key ($flatpak)"
            fi
        fi
    done < <(python3 -c "
import json, sys
try:
    with open(sys.argv[1], encoding='utf-8') as f:
        data = json.load(f)
    for app in data.get('apps', []):
        name = app.get('displayName', '').strip()
        if name:
            print(name)
except Exception:
    pass
" "$REGJSON" 2>/dev/null)
fi

# ── Exclusive app-data publication and outcome ──────────────────────────────
base="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
library=""
for candidate in "$base/lib/wootc_import_safety.py" \
    "$base/../lib/wootc/wootc_import_safety.py" \
    /usr/lib/wootc/migration/lib/wootc_import_safety.py; do
    if [[ -f "$candidate" ]]; then
        library="$candidate"
        break
    fi
done
[[ -n "$library" ]] || { log "ERROR: safe import library is not installed"; exit 1; }
copy_status=0
python3 - "$library" "$HOST" "$name" "$home" "$target_uid" "$target_gid" "${entries[@]}" <<'PY' || copy_status=$?
import configparser
import contextlib
import ctypes
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import sys
from types import SimpleNamespace
import uuid

library, host, username, home_path, uid, gid, *raw_entries = sys.argv[1:]
uid, gid = int(uid), int(gid)
sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location("wootc_import_safety", library)
safety = importlib.util.module_from_spec(spec)
spec.loader.exec_module(safety)
entries = [json.loads(entry) for entry in raw_entries]
result = safety.outcome()
result["apps"] = entries
libc = ctypes.CDLL(None, use_errno=True)
source_root = Path(host) / "Users" / username


def inode(details):
    return details.st_dev, details.st_ino, stat.S_IFMT(details.st_mode)


@contextlib.contextmanager
def source_directory(path):
    # Source fds may require root on NTFS, but all destination calls below run
    # as the target user. Reuse the helper's privileged read-only opener.
    original_uid = os.geteuid()
    fd = None
    try:
        try:
            if os.getuid() == 0:
                os.seteuid(0)
            fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
            for part in Path(path).absolute().parts[1:]:
                child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                os.close(fd)
                fd = child
            before = os.fstat(fd)
            attributes = os.listxattr(fd)
            if (getattr(before, "st_file_attributes", 0) & 0x400 or
                    any(key in attributes for key in ("system.ntfs_reparse_data", "system.ntfs_reparse_tag", "user.ntfs.reparse_data"))):
                raise safety.Refusal("Windows reparse directory refused")
            children = [(name, os.stat(name, dir_fd=fd, follow_symlinks=False))
                        for name in sorted(os.listdir(fd))]
        finally:
            if os.geteuid() != original_uid:
                os.seteuid(original_uid)
        yield fd, children
        try:
            if os.getuid() == 0:
                os.seteuid(0)
            if inode(before) != inode(os.stat(path, follow_symlinks=False)):
                raise safety.Refusal("source directory changed during copy")
            after = os.fstat(fd)
            if (before.st_mtime_ns, before.st_ctime_ns) != (after.st_mtime_ns, after.st_ctime_ns):
                raise safety.Refusal("source directory changed during copy")
        finally:
            if os.geteuid() != original_uid:
                os.seteuid(original_uid)
    finally:
        if fd is not None:
            os.close(fd)


def copy_tree(source, relative):
    with source_directory(source) as (_fd, children):
        with home.directory(relative):
            pass
        for name, details in children:
            destination = str(Path(relative) / name)
            if stat.S_ISDIR(details.st_mode):
                copy_tree(source / name, destination)
            elif stat.S_ISREG(details.st_mode):
                state = home.publish(destination, source=source / name, mode=0o600)
                if state != "copied":
                    raise safety.Refusal("staging file collided during copy")
            else:
                raise safety.Refusal("source contains a symlink, reparse point, or special file")


@contextlib.contextmanager
def destination_directory(relative, create=True):
    if inode(os.stat(home.path, follow_symlinks=False)) != inode(os.fstat(home.fd)):
        raise safety.Refusal("target home changed during copy")
    if Path(relative) == Path("."):
        fd = os.dup(home.fd)
        try:
            yield fd
        finally:
            os.close(fd)
    else:
        with home.directory(relative, create=create) as fd:
            yield fd


def publish_tree(source, relative, metadata=None):
    destination = Path(relative)
    with destination_directory(str(destination.parent)) as parent:
        try:
            os.stat(destination.name, dir_fd=parent, follow_symlinks=False)
            return "preserved"
        except FileNotFoundError:
            pass
        name = ".wootc-app-" + uuid.uuid4().hex + ".partial"
        os.mkdir(name, 0o700, dir_fd=parent)
        stage = destination.parent / name
        with home.directory(str(stage), create=False) as stage_fd:
            if metadata is None:
                copy_tree(source, str(stage))
            else:
                copy_tree(source, str(stage / "windows-import.wootc"))
                if home.publish(str(stage / "profiles.ini"), data=metadata, mode=0o600) != "copied":
                    raise safety.Refusal("Thunderbird registration staging collided")
            with destination_directory(str(destination.parent), create=False) as current:
                if inode(os.fstat(current)) != inode(os.fstat(parent)):
                    raise safety.Refusal("destination parent changed during copy")
            if inode(os.stat(name, dir_fd=parent, follow_symlinks=False)) != inode(os.fstat(stage_fd)):
                raise safety.Refusal("staging directory changed during copy")
            rename = getattr(libc, "renameat2", None)
            if rename is None:
                raise safety.Refusal("renameat2(RENAME_NOREPLACE) is required")
            rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
            rename.restype = ctypes.c_int
            if rename(parent, os.fsencode(name), parent, os.fsencode(destination.name), 1) != 0:
                code = ctypes.get_errno()
                raise OSError(code, os.strerror(code), relative)
            if inode(os.stat(destination.name, dir_fd=parent, follow_symlinks=False)) != inode(os.fstat(stage_fd)):
                raise safety.Refusal("published app directory changed")
            with destination_directory(str(destination.parent), create=False) as current:
                if inode(os.fstat(current)) != inode(os.fstat(parent)):
                    raise safety.Refusal("destination parent changed during publication")
            os.fsync(parent)
    return "copied"


def operation(app, relative, callback):
    state = callback()
    key = {"copied": "migrated", "already-present": "alreadyPresent", "preserved": "preserved"}[state]
    result[key].append(relative)
    app.setdefault(key, []).append(relative)
    return state


def vscode(app):
    source = source_root / "AppData/Roaming/Code/User"
    with source_directory(source) as (_fd, children):
        names = {name for name, _details in children}
    for name in ("settings.json", "keybindings.json"):
        if name in names:
            relative = ".config/Code/User/" + name
            operation(app, relative, lambda r=relative, p=source / name: home.publish(r, source=p, mode=0o600))
    if "snippets" in names:
        relative = ".config/Code/User/snippets"
        operation(app, relative, lambda: publish_tree(source / "snippets", relative))
    extensions = source_root / ".vscode/extensions"
    try:
        with source_directory(extensions) as (_fd, children):
            names = sorted({re.sub(r"-[0-9][0-9.]*$", "", name) for name, _details in children})
    except FileNotFoundError:
        names = None
    if names is not None:
        relative = ".config/wootc/vscode-extensions.txt"
        operation(app, relative, lambda: home.publish(relative, data=("".join(name + "\n" for name in names)).encode(), mode=0o600))


def thunderbird(app):
    source = source_root / "AppData/Roaming/Thunderbird"
    parser = configparser.RawConfigParser()
    parser.read_string(safety.source_bytes(source / "profiles.ini").decode("utf-8-sig"))
    section = next((name for name in parser.sections() if name.startswith("Profile") and parser.has_option(name, "Path")), None)
    if section is None or parser.get(section, "IsRelative", fallback="1") != "1":
        raise safety.Refusal("Thunderbird profile must be relative")
    path = parser.get(section, "Path").replace("\\", "/")
    parts = path.split("/")
    if ":" in path or any(part in ("", ".", "..") for part in parts) or any(ord(character) < 32 for character in path):
        raise safety.Refusal("unsafe Thunderbird profile path")
    metadata = (b"[Profile0]\nName=Imported from Windows\nIsRelative=1\n"
                b"Path=windows-import.wootc\nDefault=1\n\n[General]\n"
                b"StartWithLastProfile=1\nVersion=2\n")
    relative = ".thunderbird"
    operation(app, relative, lambda: publish_tree(source.joinpath(*parts), relative, metadata))


def migrate(app):
    key = app["app"]
    source = source_root / {
        "vscode": "AppData/Roaming/Code/User", "thunderbird": "AppData/Roaming/Thunderbird",
        "signal": "AppData/Roaming/Signal", "telegram": "AppData/Roaming/Telegram Desktop/tdata",
        "obs": "AppData/Roaming/obs-studio",
    }[key]
    try:
        with source_directory(source) as (_fd, children):
            names = {name for name, _details in children}
    except FileNotFoundError:
        app["note"] = "Installed on Windows; no source app data was found to copy."
        return
    if key == "vscode":
        vscode(app)
    elif key == "thunderbird":
        thunderbird(app)
    elif key == "signal":
        source = source_root / "AppData/Roaming/Signal"
        if "config.json" not in names:
            app["note"] = "No portable Signal key format found. Re-link with your phone."
            return
        config = json.loads(safety.source_bytes(source / "config.json"))
        if not isinstance(config, dict) or "key" not in config or "encryptedKey" in config:
            app["note"] = "Windows-bound Signal profile preserved. Re-link with your phone."
            return
        app["session"] = "portable"
        relative = ".var/app/org.signal.Signal/config/Signal"
        operation(app, relative, lambda: publish_tree(source, relative))
    else:
        source, relative = {
            "telegram": ("AppData/Roaming/Telegram Desktop/tdata", ".var/app/org.telegram.desktop/data/TelegramDesktop/tdata"),
            "obs": ("AppData/Roaming/obs-studio", ".var/app/com.obsproject.Studio/config/obs-studio"),
        }[key]
        operation(app, relative, lambda: publish_tree(source_root / source, relative))


home = None
try:
    if not username or username in (".", "..") or "/" in username or "\\" in username:
        raise safety.Refusal("unsafe Windows username")
    if os.geteuid() == 0:
        os.setegid(gid)
        os.seteuid(uid)
    home = safety.Home(SimpleNamespace(pw_uid=uid, pw_gid=gid, pw_dir=home_path))
    with home.lock():
        home.record(".config/wootc/bridge-apps.json", {**result, "status": "partial"})
        for app in entries:
            if app["app"] not in ("vscode", "telegram", "signal", "thunderbird", "obs"):
                continue
            app["copied"] = False
            try:
                migrate(app)
                changed = bool(app.get("migrated") or app.get("alreadyPresent"))
                preserved = bool(app.get("preserved"))
                app["state"] = "partial" if preserved and changed else "unchanged" if preserved or not changed else "native"
                app["copied"] = changed and not preserved
                if changed:
                    app["note"] = "Complete files copied; existing native files preserved where listed. Open the app to verify. Authentication is not verified."
                elif preserved:
                    app["note"] = "Existing Linux app data preserved; no imported session is claimed."
            except (OSError, ValueError, configparser.Error, UnicodeError) as error:
                app["state"] = "failed"
                app["errors"] = [str(error)]
                app["note"] = "Copy failed or was refused; native data preserved. Review retained staging before retrying."
                result["failed"].append({"app": app["app"], "error": str(error)})
        safety.finish(home, ".config/wootc/bridge-apps.json", result)
except (OSError, ValueError) as error:
    print("[wootc-detect-apps] " + str(error), file=sys.stderr)
    sys.exit(1)
finally:
    if home is not None:
        home.close()
sys.exit(1 if result["failed"] else 0)

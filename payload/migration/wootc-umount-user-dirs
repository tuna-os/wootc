#!/bin/bash
# /usr/local/bin/wootc-umount-user-dirs
# Reverses wootc-mount-user-dirs on shutdown (ExecStop of
# wootc-passthrough.service), so wootc-host-bind.service can unmount /run/wootc/host
# cleanly afterward without "target is busy" from nested bind mounts.

set -Eeuo pipefail

FOLDERS=(Documents Pictures Downloads Music Videos Desktop)

for home in /home/*/; do
    for folder in "${FOLDERS[@]}"; do
        dst="${home}${folder}"
        mountpoint -q "$dst" 2>/dev/null && umount "$dst" 2>/dev/null || true
    done
done

# Give Windows back the read-only folder flags wootc-mount-user-dirs cleared
# for this session, while the writable host mount is still there. The record
# stays on the volume when this fails, and the next boot restores from it.
HOST="${WOOTC_HOST:-/run/wootc/host}"
helper=/var/usrlocal/bin/wootc-folder-flags
if [[ -x "$helper" ]] || helper=$(command -v wootc-folder-flags 2>/dev/null); then
    "$helper" restore "$HOST" >/dev/null ||
        echo "[wootc-passthrough] WARNING: not every Windows folder flag could be restored; the next boot retries" >&2
fi

# BitLocker cleanup (#61): unmount and lock the temporary BitLocker volume
# that wootc-mount-user-dirs unlocked. Runs AFTER all home binds are released
# so the underlying NTFS mount is no longer busy.
for mnt in /run/wootc/bitlk-tmp; do
    mountpoint -q "$mnt" 2>/dev/null && umount "$mnt" 2>/dev/null || true
done
for mapper in /dev/mapper/wootc-bitlk-*; do
    [[ -b "$mapper" ]] && cryptsetup close "$(basename "$mapper")" 2>/dev/null || true
done

# The recovery key is NOT shredded here. This runs on every shutdown, and the
# bridge unlocks C: again on every boot to bind the folders live, so a shred
# here made every unconverted folder vanish on the second boot (#279). The
# key lives in /etc/wootc/bitlocker-key (the deployer moved it off NTFS) and
# wootc-convert-dir retires it once nothing is bridged from C: any more.

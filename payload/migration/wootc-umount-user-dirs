#!/bin/bash
# /usr/local/bin/wootc-umount-user-dirs
# Reverses wootc-mount-user-dirs on shutdown (ExecStop of
# wootc-passthrough.service), so wootc-host-bind.service can unmount /run/wootc/host
# cleanly afterward without "target is busy" from nested bind mounts.

set -Eeuo pipefail

FOLDERS=(Documents Pictures Downloads Music Videos Desktop)

for home in /home/*/; do
    for folder in "${FOLDERS[@]}"; do
        dst="${home}${folder}"
        mountpoint -q "$dst" 2>/dev/null && umount "$dst" 2>/dev/null || true
    done
done

# BitLocker cleanup (#61): unmount and lock the temporary BitLocker volume
# that wootc-mount-user-dirs unlocked. Runs AFTER all home binds are released
# so the underlying NTFS mount is no longer busy.
for mnt in /run/wootc/bitlk-tmp; do
    mountpoint -q "$mnt" 2>/dev/null && umount "$mnt" 2>/dev/null || true
done
for mapper in /dev/mapper/wootc-bitlk-*; do
    [[ -b "$mapper" ]] && cryptsetup close "$(basename "$mapper")" 2>/dev/null || true
done

# Credential hygiene: the BitLocker recovery key was only needed to unlock
# the former Windows C: for profile discovery. The vault.json policy is
# "no credentials persist on NTFS" (deploy.sh shreds it) — the recovery
# key must not outlive the migration either. The volume is now locked, so
# shred the key file from the storage drive (tuna-os/wootc#279).
for key_file in \
    /run/wootc/host/wootc/install/bitlocker-key.txt \
    /run/wootc/host/*/wootc/install/bitlocker-key.txt; do
    if [[ -f "$key_file" ]]; then
        shred -u "$key_file" 2>/dev/null || rm -f "$key_file"
        echo "[wootc] shredded BitLocker recovery key $key_file" >&2
    fi
done

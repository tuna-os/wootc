#!/usr/bin/python3
"""Verify complete EFI trios; issuer names and certificate bags are not proof."""
import hashlib
import os
from pathlib import Path
import sys
sys.path.insert(0,os.environ.get('WOOTC_CHAIN_LIBRARY','/var/usrlocal/lib/wootc'))
from wootc_chain_verify import verify_transition,efi_variable,checked_database,DB_GUID
from wootc_pe import PE,X509


def main(argv):
    if len(argv)==3 and argv[0]=='chain':
        verify_transition(Path(argv[1]),Path(argv[2]),
            Path(os.environ.get('WOOTC_EFIVARS','/sys/firmware/efi/efivars')),
            Path(os.environ.get('WOOTC_SBVERIFY','/var/usrlocal/lib/wootc/sbverify')))
        print('complete trio signatures, exact role trust and mixed policy verified')
        return 0
    if len(argv)==2 and argv[0]=='sbat':
        print(PE(Path(argv[1]).read_bytes()).sbat()['shim']);return 0
    if argv==['db']:
        values=checked_database(efi_variable(Path(os.environ.get('WOOTC_EFIVARS','/sys/firmware/efi/efivars')),'db',DB_GUID))
        print('\n'.join(hashlib.sha256(value).hexdigest() for kind,value in values if kind==X509));return 0
    print('[wootc-shim-trust] use chain CURRENT_TRIO CANDIDATE_TRIO; single-file issuer metadata cannot authorize publication',file=sys.stderr)
    return 2


if __name__=='__main__':
    try:sys.exit(main(sys.argv[1:]))
    except (OSError,ValueError,KeyError,TypeError) as error:
        print('[wootc-shim-trust] refused: '+str(error),file=sys.stderr);sys.exit(1)

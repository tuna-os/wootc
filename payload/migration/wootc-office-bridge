#!/bin/bash
# MS Office -> LibreOffice dictionary/templates/fonts bridge.
# The Python implementation publishes complete new files without overwriting
# native edits; dictionary append recovery is recorded separately.
set -Eeuo pipefail
base="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
for library in "$base/lib/wootc_import_safety.py" \
    "$base/../lib/wootc/wootc_import_safety.py" \
    /usr/lib/wootc/migration/lib/wootc_import_safety.py; do
    if [[ -f "$library" ]]; then
        exec python3 "$library" office "$@"
    fi
done
printf '%s\n' '[wootc-office-bridge] ERROR: safe import library is not installed' >&2
exit 1

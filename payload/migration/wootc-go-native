#!/bin/bash
# /usr/local/bin/wootc-go-native — Phase 3: the "commit to Linux" stage.
#
# On a running Phase-2 system (Linux booting from root.disk, a loopback VHDX on
# the Windows NTFS partition), this is where the user decides to move to Linux
# only: graduate the root filesystem onto a real native partition and, if they
# choose, delete the Windows partition and grow Linux to reclaim the space
# (SPEC §4.2 stages 5-6).
#
# SAFETY MODEL. Stage 6 is irreversible and destroys Windows, so this tool is
# built inside-out: the analysis path (`plan`, `check`) is complete and safe to
# run anywhere; the destructive path (`migrate`) is GUARDED and deliberately
# not enabled until it has been proven against a booted Phase-2 system on real
# hardware (verification ladder rung 2 → rung 3). It refuses to touch a disk
# until then, by design — better an explicit "not yet" than a blind repartition.
#
#   wootc-go-native plan            analyze layout + print the plan (safe)
#   wootc-go-native check           exit 0 if preconditions for going native hold
#   wootc-go-native migrate ...     GUARDED — destructive repartition (stub)
#
# Test hooks (fixtures, no real disks): WOOTC_GN_ROOT_SRC, WOOTC_GN_LSBLK,
# WOOTC_GN_HOSTCONF, WOOTC_GN_HOME, WOOTC_GN_FORCE_LOOP, WOOTC_GN_ETC.

set -Eeuo pipefail

# GUI launchers and QEMU Guest Agent commands inherit a service-manager PATH,
# not an interactive shell's. Bluefin installs administrative tools such as
# podman, bootc, sfdisk, and efibootmgr under /usr/sbin; without an explicit
# system PATH Phase 3 reaches its verified blank disk and then fails with
# `podman: command not found` despite the binary being installed.
export PATH="/var/usrlocal/sbin:/var/usrlocal/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

log()  { printf '[wootc-go-native] %s\n' "$*" >&2; }
die()  { printf '[wootc-go-native] ERROR: %s\n' "$*" >&2; exit 1; }

HOSTCONF="${WOOTC_GN_HOSTCONF:-/etc/wootc/host-esp.conf}"

# root_source — the block device / image backing "/". On a Phase-2 system this
# is the NBD-attached root.disk (/dev/nbd0pN); on a native system it is a real
# partition. The distinction is the whole point of "are we still on loopback?".
root_source() {
    if [[ -n "${WOOTC_GN_ROOT_SRC:-}" ]]; then echo "$WOOTC_GN_ROOT_SRC"; return; fi
    findmnt -n -o SOURCE / 2>/dev/null || true
}

# on_loopback — true when Linux is still hosted inside root.disk on NTFS.
on_loopback() {
    [[ "${WOOTC_GN_FORCE_LOOP:-}" == "1" ]] && return 0
    [[ "${WOOTC_GN_FORCE_LOOP:-}" == "0" ]] && return 1
    local src; src=$(root_source)
    [[ "$src" == /dev/nbd* ]] && return 0
    [[ -e /run/wootc-loop-attached ]] && return 0
    grep -qE '(^| )(loop|wootc\.rootdisk)=' /proc/cmdline 2>/dev/null && return 0
    return 1
}

# converted_folders — which user media folders have been made native already
# (stage 4). Uses the ~/.config/wootc/converted-* markers wootc-convert-dir writes.
converted_folders() {
    local home="${WOOTC_GN_HOME:-${HOME:-/root}}" f
    for f in "$home"/.config/wootc/converted-*; do
        [[ -e "$f" ]] || continue
        basename "$f" | sed 's/^converted-//'
    done
}

# ── plan ────────────────────────────────────────────────────────────────────
cmd_plan() {
    local src loop hostuuid bootloader
    src=$(root_source)
    if on_loopback; then loop="yes"; else loop="no"; fi
    hostuuid=""; bootloader=""
    if [[ -r "$HOSTCONF" ]]; then
        hostuuid=$(grep -oP 'HOST_ESP_UUID=\K.*' "$HOSTCONF" 2>/dev/null || true)
        bootloader=$(grep -oP 'BOOTLOADER=\K.*' "$HOSTCONF" 2>/dev/null || true)
    fi
    local converted; converted=$(converted_folders | paste -sd, - 2>/dev/null || true)

    echo   "wootc — Move to Linux only (Phase 3)"
    echo   "───────────────────────────────────"
    printf 'Root filesystem source : %s\n' "${src:-unknown}"
    printf 'Still on Windows NTFS  : %s\n' "$loop"
    printf 'Host ESP UUID          : %s\n' "${hostuuid:-unknown}"
    printf 'Host bootloader        : %s\n' "${bootloader:-unknown}"
    printf 'Folders made native    : %s\n' "${converted:-none yet}"
    echo
    if [[ "$loop" == "no" ]]; then
        echo "This system already runs from a native Linux partition — nothing to graduate."
        echo "If Windows is still present you can reclaim its space with:  migrate --reclaim"
        return 0
    fi
    cat <<'PLAN'
Planned stages when you commit:

  5. Graduate root to native
     • Deploy the same bootc image onto a real Linux partition (no re-download —
       the OCI content already lives in root.disk).
     • Copy your home data onto it. Nothing on Windows is touched yet.
     • Switch the boot entry from the root.disk loopback chain to the native
       partition. (Reversible: root.disk stays until stage 6.)

  6. Remove Windows  (IRREVERSIBLE)
     • Only offered once every folder you use is native (see "Folders made
       native" above) and a rollback snapshot exists.
     • Delete the Windows partition, grow Linux to fill the disk, and remove the
       Windows Boot Manager / BCD one-shot chain.

Run 'wootc-go-native check' to see whether the safety preconditions are met.
PLAN
}

# ── check ───────────────────────────────────────────────────────────────────
# Exit 0 only if it is SAFE to begin going native. Prints each gate's result.
cmd_check() {
    local ok=0
    if on_loopback; then
        echo "[ok]   running from root.disk (loopback) — graduation applies"
    else
        echo "[skip] already native — stage 5 not applicable"
    fi
    if [[ -r "$HOSTCONF" ]]; then
        echo "[ok]   host layout recorded ($HOSTCONF)"
    else
        echo "[warn] $HOSTCONF missing — cannot locate the Windows ESP/partition"
        ok=1
    fi
    # A rollback snapshot is required before any destructive step.
    if command -v btrfs >/dev/null && btrfs subvolume show / >/dev/null 2>&1; then
        echo "[ok]   btrfs root — snapshot rollback available for stage 5/6"
    else
        echo "[warn] no btrfs snapshot capability detected — stage 6 stays disabled"
    fi
    local conv; conv=$(converted_folders | wc -l)
    echo "[info] $conv user folder(s) already native"
    # Non-destructive NTFS shrink verification (Phase 3-A gate).
    if discover_layout; then
        local shrink_result
        shrink_result=$(check_shrinkable "$NTFS_DEV" 2>&1 || true)
        if [[ "$shrink_result" == "[ok]"* ]]; then
            echo "[ok]   NTFS shrink safety: $shrink_result"
        else
            echo "[warn] NTFS shrink check: $shrink_result"
            # Not a hard gate — dual-boot to a spare disk is still available.
        fi
    fi
    return $ok
}

# ── disk layout discovery ────────────────────────────────────────────────────
# Populate DISK (whole device with Windows), ESP_DEV, NTFS_DEV. On a Phase-2
# system root is /dev/nbdNpM (a loopback of root.disk inside the NTFS), so the
# real disk is found via the host ESP UUID recorded at deploy time. Test hooks:
# WOOTC_GN_DISK / WOOTC_GN_ESP / WOOTC_GN_NTFS bypass the probing.
DISK=""; ESP_DEV=""; NTFS_DEV=""
discover_layout() {
    DISK="${WOOTC_GN_DISK:-}"; ESP_DEV="${WOOTC_GN_ESP:-}"; NTFS_DEV="${WOOTC_GN_NTFS:-}"
    if [[ -z "$ESP_DEV" && -r "$HOSTCONF" ]]; then
        local uuid; uuid=$(grep -oP 'HOST_ESP_UUID=\K.*' "$HOSTCONF" 2>/dev/null || true)
        [[ -n "$uuid" ]] && ESP_DEV=$(blkid -U "$uuid" 2>/dev/null || true)
    fi
    [[ -n "$DISK" || -z "$ESP_DEV" ]] || DISK="/dev/$(lsblk -no PKNAME "$ESP_DEV" 2>/dev/null | head -1)"
    if [[ -z "$NTFS_DEV" && -n "$DISK" ]]; then
        # The largest NTFS partition on that disk is where root.disk lives.
        NTFS_DEV=$(lsblk -bnro PATH,FSTYPE,SIZE "$DISK" 2>/dev/null \
            | awk '$2=="ntfs"||$2=="ntfs3"{print $3, $1}' | sort -nr | head -1 | awk '{print $2}')
    fi
    [[ -n "$DISK" && -n "$NTFS_DEV" ]]
}

# next_partnum — the next free partition number on DISK.
next_partnum() {
    local n; n=$(lsblk -nro NAME "$DISK" 2>/dev/null | grep -oE '[0-9]+$' | sort -n | tail -1)
    echo $(( ${n:-0} + 1 ))
}

# check_shrinkable — read-only NTFS shrink safety analysis (Phase 3-A gate).
# Runs ntfsresize --info to verify the NTFS volume can be shrunk non-destructively
# without a Windows chkdsk cycle. Returns 0 if shrinkable, prints the available
# shrink space; returns 1 with a diagnostic if shrink is unsafe or the volume
# needs a clean Windows shutdown first. Test hook: WOOTC_GN_NTRESIZE_INFO.
check_shrinkable() {
    local dev="${1:-$NTFS_DEV}" info_file="${WOOTC_GN_NTRESIZE_INFO:-}" info
    if [[ -n "$info_file" ]]; then
        # Fixture hook: supply a canned ntfsresize --info output.
        # Allows tests to exercise the shrink logic without a real block device.
        info=$(<"$info_file")
    elif [[ ! -b "$dev" ]]; then
        echo "[block] not a block device"; return 1
    elif command -v ntfsresize >/dev/null 2>&1; then
        info=$(ntfsresize --info "$dev" 2>&1 || true)
    else
        echo "[warn] ntfsresize not available — cannot verify shrink safety"
        return 0  # not a hard gate; the plan will warn the user
    fi
    # Gate 1: the volume must not be flagged dirty (Windows hibernated / Fast Startup).
    if echo "$info" | grep -qE 'Volume is dirty|has been run [0-9]+ times|must be checked|The volume is dirty'; then
        echo "[dirty] NTFS volume is flagged dirty — boot Windows once and perform a full shutdown (not restart)"
        return 1
    fi
    # Gate 2: the volume must have enough free space to shrink into.
    # ntfsresize reports "You might resize at NNNN bytes" — the current
    # data size plus slack, already rounded up to a cluster boundary.
    # Below that, data loss is certain; a safe default adds headroom.
    local curr_size new_min
    curr_size=$(echo "$info" | grep -oP 'Current volume size:\s*\K[0-9]+' | head -1)
    new_min=$(echo "$info"  | grep -oP 'You might resize at\s*\K[0-9]+' | head -1)
    if [[ -z "$curr_size" || -z "$new_min" ]]; then
        echo "[parse] could not parse ntfsresize output for $dev"
        return 1
    fi
    local can_free=$(( (curr_size - new_min) / (1024*1024*1024) ))
    if (( can_free <= 0 )); then
        echo "[nospace] NTFS filesystem has no free space to shrink (current=${curr_size} min=${new_min})"
        return 1
    fi
    echo "[ok] NTFS shrinkable: $can_free GiB available (current $(numfmt --to=iec $curr_size), min $(numfmt --to=iec $new_min))"
    return 0
}

# graduate_plan — the exact command sequence to move onto a native partition
# while keeping Windows (reversible). Printed for review; run only with execute.
graduate_plan() {
    local shrink_gib="${WOOTC_GN_SHRINK_GIB:-0}" newpart localref
    newpart="${DISK}$(next_partnum)"
    localref="containers-storage:$(bootc_local_imgref)"

    # Non-destructive NTFS shrink safety gate (Phase 3-A): verify before printing the plan.
    local shrink_info=""
    if discover_layout; then
        shrink_info=$(check_shrinkable "$NTFS_DEV" 2>&1 || true)
    fi
    [[ -z "$shrink_info" ]] && shrink_info="[skip] layout not discoverable"

    # Safe default for shrink size: use available space minus a 2 GiB headroom
    # so Windows still has breathing room after the resize.
    local safe_default_gib=0
    if [[ "$shrink_info" == "[ok]"* ]]; then
        safe_default_gib=$(echo "$shrink_info" | grep -oP '[0-9]+(?= GiB available)' | head -1)
        safe_default_gib=$(( safe_default_gib > 4 ? safe_default_gib - 2 : safe_default_gib ))
    fi
    [[ "${WOOTC_GN_SHRINK_GIB:-0}" -gt 0 ]] || WOOTC_GN_SHRINK_GIB="$safe_default_gib"
    shrink_gib="${WOOTC_GN_SHRINK_GIB:-0}"

    cat <<PLAN
Graduate to native (dual-boot — Windows stays, fully reversible)
Disk: $DISK   Windows NTFS: $NTFS_DEV   ESP: $ESP_DEV
New native partition: $newpart
NTFS shrink safety  : $shrink_info
Safe shrink default : ${shrink_gib} GiB (override with WOOTC_GN_SHRINK_GIB=N)

Commands (each verified before the next):
  1. Snapshot for rollback:
       btrfs subvolume snapshot -r / /.wootc-prenative   (or: bootc rollback point)
  2. Make room by shrinking Windows (only if no free tail space):
       ntfsresize --info $NTFS_DEV        # confirm shrinkable
       ntfsresize --size -${shrink_gib}Gi $NTFS_DEV
       sfdisk -N <win#> $DISK             # shrink the partition entry to match
  3. Create + format the native partition:
       sfdisk --append $DISK  <<< 'type=linux'      # → $newpart
       mkfs.xfs -f $newpart
  4. Install the OS onto it from the ALREADY-LOCAL image (no download):
       mount $newpart /mnt/native
       bootc install to-filesystem --source-imgref $localref \\
           --acknowledge-destructive --generic-image \\
           --karg rw --root-mount-spec UUID=<new> /mnt/native
  5. Migrate your data off root.disk:
       rsync -aHAX --info=progress2 /home/ /mnt/native/home/
  6. Point the boot default at the native partition (bootupd owns the ESP):
       bootupctl backend generate-update-metadata /mnt/native
       efibootmgr -c -d $DISK -p 1 -L 'TunaOS' -l '\\EFI\\almalinux\\shimx64.efi'
       efibootmgr -o <native>,<windows>          # native first, Windows kept
  7. Reboot. You are now on the native partition; root.disk + Windows remain
     for rollback until you run 'migrate --reclaim'.
PLAN
}

# reclaim_plan — stage 6, printed only when data-is-native preconditions hold.
reclaim_plan() {
    cat <<PLAN
Remove Windows and reclaim its space (IRREVERSIBLE)
Disk: $DISK   deleting: $NTFS_DEV (Windows) + root.disk inside it

Commands:
  1. Refuse unless already running native (not from root.disk) AND every used
     folder is converted (see 'check').
  2. Delete the Windows partition:  sfdisk --delete $DISK <win#>
  3. Grow the native partition into the freed space:
       growpart $DISK <native#>  &&  xfs_growfs /
  4. Remove the Windows Boot Manager entry:  efibootmgr -Bb <windows>
PLAN
}

# bootc_local_imgref — the deployer's authoritative registry origin.  `bootc
# status` reports the transient localhost/wootc-ntfs-injected tag when Phase 2
# needed an NTFS compatibility layer, but that tag belonged to the deployer's
# separate containers-storage and cannot be pulled in the installed system.
bootc_local_imgref() {
    local configured=""
    if [[ -r "$HOSTCONF" ]]; then
        configured=$(grep -oP '^SOURCE_IMAGE_REF=\K\S+' "$HOSTCONF" 2>/dev/null | head -1 || true)
    fi
    if [[ "$configured" =~ ^[a-zA-Z0-9._-]+([.:][a-zA-Z0-9._-]+)*/[a-zA-Z0-9._/-]+(:[a-zA-Z0-9._-]+|@sha256:[a-fA-F0-9]{64})?$ ]]; then
        echo "$configured"
        return 0
    fi
    bootc status --json 2>/dev/null | grep -oP '"image":\s*"\K[^"]+' | head -1 \
        || echo "ghcr.io/tuna-os/yellowfin:gnome"
}

# ── Graduation scratch ──────────────────────────────────────────────────────
# fisherman's podman-run install needs the whole image in local
# containers-storage. Pulled into root.disk's own /var, that copy comes on top
# of the installed system: bluefin:stable (4.6 GiB of compressed layers) filled
# a 30 GiB root.disk on all four pull attempts (run 44743470001, "no space left
# on device" under /var/lib/containers). Stage it as the deployer does
# instead: an ext4 file next to root.disk on the Windows volume, sized from the
# image, mounted at /var/fisherman-tmp and over /var/lib/containers, and
# deleted afterwards. root.disk keeps no second copy of the image.
#
# The mounts are made in the system's own mount namespace, as the deployer's
# are. bootc, inside fisherman's install container, looks its source image up
# with `podman inspect` in PID 1's mount namespace; with the scratch mounted in
# a private namespace that store was not there, and the install failed with
# 'no such object: "<image id>"' (probe 44825571768).
GN_SELF=$(readlink -f "${BASH_SOURCE[0]}")
GN_SCRATCH_MIN_GIB=20

# graduation_scratch_gib — GiB the scratch must hold for <compressed layer
# bytes>: deploy.sh's scratch_need_gib formula (3.5x the compressed layers
# covers blob staging plus the worst measured unpack ratio, +4 GiB ext4
# metadata), so an image that deployed also graduates.
graduation_scratch_gib() {
    local bytes=$1 gib=$((1 << 30)) need
    if [[ ! "$bytes" =~ ^[0-9]+$ ]] || (( bytes == 0 )); then
        echo "$GN_SCRATCH_MIN_GIB"
        return 0
    fi
    need=$(( (bytes * 7 / 2 + gib - 1) / gib + 4 ))
    (( need < GN_SCRATCH_MIN_GIB )) && need=$GN_SCRATCH_MIN_GIB
    echo "$need"
}

# image_layer_bytes — the sum of <ref>'s compressed layers as the registry's
# manifest states them (no download). Prints nothing when it cannot be read.
image_layer_bytes() {
    local sizes total=0 s
    sizes=$(timeout 120 skopeo inspect --retry-times 3 \
        --format '{{range .LayersData}}{{.Size}} {{end}}' "docker://$1" 2>/dev/null) || return 0
    for s in $sizes; do
        [[ "$s" =~ ^[0-9]+$ ]] && total=$(( total + s ))
    done
    (( total > 0 )) && echo "$total"
    return 0
}

# host_wootc_dir — the wootc directory on the Windows volume: the parent of
# the disks/ directory holding the root.disk loop file that backs this system.
#
# The initramfs attaches root.disk through its own NTFS mount. When that mount
# is not reachable from the real root, the kernel reports the backing path
# from the volume's root: "/wootc/disks/root.disk" (fuse-ntfs-3g, E2E
# 39007144179; bluefin gate probe 44781443975, where `df /wootc` then failed).
# The volume stays mounted at the private host mount, so the path is looked
# up there and accepted, as wootc_boot_identity.loop_backs_file does, only
# when the file is exactly as large as the loop device.
GN_SYSFS=/sys
GN_HOST_MNT=/run/initramfs/wootc-host
host_wootc_dir() {
    if [[ -n "${WOOTC_GN_HOST_DIR:-}" ]]; then echo "$WOOTC_GN_HOST_DIR"; return 0; fi
    local mp src dev backing sectors bytes
    for mp in /sysroot /; do
        src=$(findmnt -nvo SOURCE "$mp" 2>/dev/null || true)
        [[ "$src" == /dev/* ]] || continue
        dev=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1 || true)
        [[ -n "$dev" ]] || dev=${src#/dev/}
        backing=$(cat "$GN_SYSFS/block/$dev/loop/backing_file" 2>/dev/null || true)
        [[ "$backing" == /* && "$backing" != *" (deleted)" ]] || continue
        if [[ ! -f "$backing" && -f "$GN_HOST_MNT$backing" ]]; then
            sectors=$(cat "$GN_SYSFS/block/$dev/size" 2>/dev/null || true)
            bytes=$(stat -c %s "$GN_HOST_MNT$backing" 2>/dev/null || true)
            [[ "$sectors" =~ ^[0-9]+$ && "$bytes" =~ ^[0-9]+$ ]] && (( sectors * 512 == bytes )) \
                && backing="$GN_HOST_MNT$backing"
        fi
        if [[ -f "$backing" ]]; then
            dirname "$(dirname "$backing")"
            return 0
        fi
    done
    return 1
}

# native_install_staged — create the scratch, then pull <img> and run
# fisherman <recipe> on it (cmd_staged_install, in a child process that
# unmounts the scratch when it exits). Refuses with the numbers, before
# writing anything, when the Windows volume cannot hold the scratch.
native_install_staged() {
    local img=$1 recipe=$2 hostdir scratch need free dfout rc=0
    hostdir=$(host_wootc_dir) \
        || die "cannot locate the Windows volume that holds root.disk (no loop backing file under /sysroot or /)"
    scratch="$hostdir/cache/native-scratch.img"
    rm -f "$scratch"
    need=$(graduation_scratch_gib "$(image_layer_bytes "$img")")
    # An unreadable free-space figure is its own failure, never "0 GiB free"
    # (gate probe 44771739639 refused with "the drive has 0 GiB free" and no
    # way to tell an empty df from a full drive).
    dfout=$(df -B1 --output=avail "$hostdir" 2>&1) \
        || die "cannot read the free space of the Windows drive at $hostdir: $(tr '\n' ' ' <<<"$dfout")"
    free=$(tail -1 <<<"$dfout" | tr -d ' ')
    [[ "$free" =~ ^[0-9]+$ ]] \
        || die "cannot read the free space of the Windows drive at $hostdir (df printed: $(tr '\n' ' ' <<<"$dfout"))"
    # Keep 1 GiB beyond the scratch: Windows still writes to this volume.
    if (( free < ((need + 1) << 30) )); then
        # Name what holds the space so the refusal can be checked against
        # the drive: the volume totals and the largest files wootc keeps there.
        log "Windows drive at $hostdir: $(df -h --output=size,used,avail "$hostdir" 2>&1 | tail -1)"
        log "largest files under $hostdir: $(find "$hostdir" -xdev -type f -size +1G -printf '%p %s bytes; ' 2>&1 | head -c 2000)"
        die "$img needs about ${need} GiB of temporary space on the Windows drive to unpack (freed afterwards); the drive has $(( free >> 30 )) GiB free. Free up space in Windows and try again."
    fi
    log "Staging $img in a ${need} GiB scratch on the Windows drive ($scratch)…"
    mkdir -p "$hostdir/cache"
    if ! truncate -s "${need}G" "$scratch" || ! mkfs.ext4 -q -F "$scratch"; then
        rm -f "$scratch"
        die "cannot create the ${need} GiB scratch $scratch"
    fi
    "$GN_SELF" __staged-install "$scratch" "$img" "$recipe" || rc=$?
    rm -f "$scratch"
    return "$rc"
}

# stage_progress <disk> — while the pull and the install run, log every
# GN_PROGRESS_SECS what the scratch holds and what has reached <disk>, but
# only when one of them moved. Neither `podman pull` without a terminal nor
# bootc's deploy prints anything for minutes: gate probe 44791710524 showed
# one "Starting … migrate" line for 15 minutes and could not tell a slow pull
# from a hang. A silent log now means nothing moved.
GN_PROGRESS_SECS=30
stage_progress() {
    local disk=${1#/dev/} last="" now used written
    while sleep "$GN_PROGRESS_SECS" >/dev/null 2>&1; do
        used=$(df -BM --output=used /var/fisherman-tmp 2>/dev/null | tail -1 | tr -d ' ' || true)
        written=$(awk '{ print int($7 / 2048) }' "$GN_SYSFS/block/$disk/stat" 2>/dev/null || true)
        now="scratch ${used:-?} used, ${written:-?} MiB written to /dev/$disk"
        [[ "$now" == "$last" ]] || log "progress: $now"
        last=$now
    done
}

# cmd_staged_install — runs in its own process (native_install_staged), so its
# EXIT trap undoes every mount it made, in reverse order, whatever the outcome.
# `mount -o loop` sets autoclear, so the loop device detaches with the scratch.
#
# While it runs, root podman on this system sees the scratch store instead of
# its own: /var/lib/containers and the runroot (/run/containers, /run/libpod)
# are covered, because the runroot describes the store under it. /var/tmp is
# not covered; TMPDIR points podman's blob staging into the scratch instead.
GN_STAGED_MOUNTS=()
GN_PROGRESS_PID=""
staged_mount() {
    mount "$@" || die "cannot mount ${*: -1} for the native install"
    GN_STAGED_MOUNTS+=("${*: -1}")
}
staged_cleanup() {
    local i m
    if [[ -n "$GN_PROGRESS_PID" ]]; then kill "$GN_PROGRESS_PID" 2>/dev/null || true; fi
    for (( i = ${#GN_STAGED_MOUNTS[@]} - 1; i >= 0; i-- )); do
        m=${GN_STAGED_MOUNTS[i]}
        umount -R "$m" 2>/dev/null || umount -Rl "$m" 2>/dev/null || log "WARN: cannot unmount $m"
    done
}
cmd_staged_install() {
    local scratch=$1 img=$2 recipe=$3 pull_ok=false attempt disk
    trap staged_cleanup EXIT
    mkdir -p /var/fisherman-tmp
    staged_mount -o loop "$scratch" /var/fisherman-tmp
    mkdir -p /var/fisherman-tmp/host-containers /var/fisherman-tmp/var-tmp \
        /var/lib/containers /run/containers /run/libpod
    chmod 1777 /var/fisherman-tmp/var-tmp
    staged_mount --bind /var/fisherman-tmp/host-containers /var/lib/containers
    # A fresh runroot: the running system's podman state describes its own
    # store, not this one.
    staged_mount -t tmpfs tmpfs /run/containers
    staged_mount -t tmpfs tmpfs /run/libpod
    # containers/image stages pull blobs in $TMPDIR (default /var/tmp)
    # whatever the storage root.
    export TMPDIR=/var/fisherman-tmp/var-tmp

    disk=$(grep -oP '"disk":\s*"\K[^"]+' "$recipe" 2>/dev/null || true)
    stage_progress "$disk" &
    GN_PROGRESS_PID=$!

    # Use fisherman's podman-run mode (recipe image set): bootc runs INSIDE
    # the image container, exactly how the deployer installed root.disk — the
    # one path proven against every supported image. The two alternatives both
    # failed live on bluefin:lts:
    #   * direct mode without --source-imgref: "must be executed inside a
    #     podman container" (run 20260723T0106);
    #   * direct mode with --source-imgref containers-storage:<ref>:
    #     "Multiple commit objects found" — the containers-storage transport
    #     chokes on sealed/chunked images (run 20260723T0155).
    # Pre-pull for visible progress; podman run then uses the local copy.
    if ! podman image exists "$img" 2>/dev/null; then
        log "Pulling $img into the scratch containers-storage for the native install…"
        # Retry: this pull runs INSIDE the Phase-2 VM, over whatever network
        # that guest has — flaky on a mirror-less hosted runner (bluefin
        # phase3, GH matrix 20260724T1558: one 'network down?' died the whole
        # graduation). Podman resumes copied layers, so retries are cheap.
        for attempt in 1 2 3 4; do
            if podman pull "$img"; then pull_ok=true; break; fi
            log "  pull attempt $attempt failed (scratch: $(df -h /var/fisherman-tmp 2>/dev/null | awk 'NR==2{print $3" used of "$2}')); retrying in $((attempt*15))s…"
            sleep $((attempt*15))
        done
        [[ "$pull_ok" == true ]] || \
            die "cannot stage $img locally after 4 attempts — native install needs its content"
    fi
    fisherman "$recipe" || die "fisherman native install failed"
}

# fisherman_settings_members <timezone> <locale> <xkb layout> <xkb variant> <xkb model>
# Print the recipe members for the values that pass fisherman's recipe
# rules, one per line with a trailing comma; name the others on stderr and
# leave them out (fisherman refuses a whole recipe for one bad value). The
# deployer has the same function; settings-carry.bats keeps the two identical.
fisherman_settings_members() {
    local tz=$1 locale=$2 layout=$3 variant=$4 model=$5
    local tz_re='^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$'
    local locale_re='^([a-z]{2,3}(_[A-Z]{2,3})?|C|POSIX)(\.[A-Za-z0-9][A-Za-z0-9_-]*)?(@[A-Za-z0-9]+)?$'
    local layout_re='^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$'
    local variant_re='^[A-Za-z0-9_.+-]*(,[A-Za-z0-9_.+-]*)*$'
    local model_re='^[A-Za-z0-9_.+-]+$'
    if [[ -n "$tz" ]]; then
        if (( ${#tz} <= 64 )) && [[ "$tz" =~ $tz_re ]]; then
            printf '"timezone": "%s",\n' "$tz"
        else
            printf 'settings: time zone %q is not an IANA name; left out\n' "$tz" >&2
        fi
    fi
    if [[ -n "$locale" ]]; then
        if (( ${#locale} <= 64 )) && [[ "$locale" =~ $locale_re ]]; then
            printf '"locale": "%s",\n' "$locale"
        else
            printf 'settings: locale %q is not a locale name; left out\n' "$locale" >&2
        fi
    fi
    if [[ -n "$layout" ]]; then
        if (( ${#layout} > 64 )) || [[ ! "$layout" =~ $layout_re ]]; then
            printf 'settings: keyboard layout %q is not an XKB layout; keyboard left out\n' "$layout" >&2
            return 0
        fi
        if (( ${#variant} > 64 )) || [[ ! "$variant" =~ $variant_re ]]; then
            printf 'settings: keyboard variant %q is not an XKB variant; variant left out\n' "$variant" >&2
            variant=""
        fi
        if [[ -n "$model" ]] && { (( ${#model} > 64 )) || [[ ! "$model" =~ $model_re ]]; }; then
            printf 'settings: keyboard model %q is not an XKB model; model left out\n' "$model" >&2
            model=""
        fi
        printf '"keyboard": {"layout": "%s"%s%s},\n' "$layout" \
            "${variant:+, \"variant\": \"$variant\"}" "${model:+, \"model\": \"$model\"}"
    fi
}

# phase2_hostname — this system's static hostname, or "wootc" when it has
# none fisherman would accept (RFC 1123 labels, at most 64 characters).
phase2_hostname() {
    local etc=${WOOTC_GN_ETC:-/etc} name=""
    local re='^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$'
    [[ -r "$etc/hostname" ]] && name=$(head -1 "$etc/hostname" | tr -d '[:space:]')
    if [[ -n "$name" ]] && (( ${#name} <= 64 )) && [[ "$name" =~ $re ]]; then
        printf '%s\n' "$name"
    else
        [[ -z "$name" ]] || log "hostname '$name' is not a valid hostname; the native install is named wootc"
        printf 'wootc\n'
    fi
}

# env_file_value <file> <key> — KEY=value from an env-style file such as
# /etc/locale.conf, without quotes. Nothing when the file or key is absent.
env_file_value() {
    [[ -r "$1" ]] || return 0
    sed -n "s/^[[:space:]]*$2=//p" "$1" | tail -1 | tr -d '"'"'"'\r'
}

# phase2_recipe_settings — the recipe members for this system's time zone
# (/etc/localtime), language (/etc/locale.conf LANG) and keyboard
# (/etc/vconsole.conf XKB*), the files fisherman writes on the native disk.
phase2_recipe_settings() {
    local etc=${WOOTC_GN_ETC:-/etc} tz="" link
    if link=$(readlink "$etc/localtime" 2>/dev/null) && [[ "$link" == *zoneinfo/* ]]; then
        tz=${link##*zoneinfo/}
    fi
    fisherman_settings_members "$tz" \
        "$(env_file_value "$etc/locale.conf" LANG)" \
        "$(env_file_value "$etc/vconsole.conf" XKBLAYOUT)" \
        "$(env_file_value "$etc/vconsole.conf" XKBVARIANT)" \
        "$(env_file_value "$etc/vconsole.conf" XKBMODEL)"
}

# graduate_to_disk_execute — install the running OS onto a whole TARGET disk via
# fisherman (reusing the local image, same as the deployer), migrate /home, and let
# UEFI boot it. Reversible: Windows + root.disk on the original disk are
# untouched, so this is the dual-boot graduate for a spare/second drive.
graduate_to_disk_execute() {
    local target="$1" img filesystem=xfs mnt=/run/wootc-native recipe=/run/wootc-native-recipe.json
    [[ -b "$target" ]] || die "not a block device: $target"
    [[ "$target" != "$DISK" ]] || die "refusing to install onto the Windows disk ($DISK)"
    img=$(bootc_local_imgref)
    if [[ -r "$HOSTCONF" ]]; then
        filesystem=$(grep -oP '^SOURCE_FILESYSTEM=\K\S+' "$HOSTCONF" 2>/dev/null | head -1 || true)
    fi
    filesystem=${filesystem:-xfs}
    case "$filesystem" in xfs|ext4|btrfs) ;; *) die "invalid recorded filesystem: $filesystem" ;; esac
    log "Installing $img onto $target as $filesystem (wipes $target only) via fisherman…"
    command -v fisherman >/dev/null || die "fisherman not found — deploy.sh must install it into the target root"

    # Mirror the running system's primary account into the native install.
    # A recipe without the user produced a native system holding the rsync'd
    # home but NO matching passwd entry, no tmpfiles home pin, and foreign
    # labels on everything under /var/home (run 20260723T0647) — a migration
    # that loses the user is not a migration. The crypt hash is copied
    # verbatim (fisherman passes $-prefixed hashes with chpasswd -e).
    local guser gfull ghash guserjson=""
    guser=$(awk -F: '$3 >= 1000 && $3 < 65534 {print $1; exit}' /etc/passwd)
    if [[ -n "$guser" ]]; then
        gfull=$(getent passwd "$guser" | cut -d: -f5)
        ghash=$(awk -F: -v u="$guser" '$1 == u {print $2}' /etc/shadow 2>/dev/null)
        [[ "$ghash" == \$* ]] || ghash=""
        guserjson=",
  \"user\": {
    \"username\": \"$guser\",
    \"fullname\": \"$gfull\",
    \"password\": \"$ghash\",
    \"groups\": [\"wheel\"]
  }"
    fi

    # The Phase-2 system's own settings, so the native system is the same
    # machine: its hostname, time zone, language and keyboard, and its
    # NetworkManager profiles (the Wi-Fi networks migrated from Windows).
    local ghost gsettings
    ghost=$(phase2_hostname)
    gsettings=$(phase2_recipe_settings)
    log "Carrying hostname $ghost${gsettings:+ and $(tr -d '\n' <<<"$gsettings")} to the native install"

    # Fisherman recipe; fisherman handles partitioning, formatting,
    # bootc install (via podman run), user creation, EFI boot entry, cleanup.
    cat > "$recipe" <<EOF
{
  "disk": "$target",
  "filesystem": "$filesystem",
  $gsettings
  "copyNetworkProfiles": true,
  "image": "$img",
  "hostname": "$ghost",
  "flatpaks": []$guserjson
}
EOF
    # fisherman checks the recipe, the target's size among it, only when the
    # install starts, which is after the pull. Ask it before: probe 44807218628
    # pulled for 41 minutes and then learned that the 40 GiB target was under
    # fisherman's 50 GiB minimum.
    fisherman validate "$recipe" >&2 \
        || die "fisherman refuses this install (see above); nothing was downloaded or written"
    native_install_staged "$img" "$recipe"
    rm -f "$recipe"

    # Post-fisherman: write wootc-specific state into the new install.
    # fisherman has already unmounted the target, so we remount the root
    # partition briefly for these writes.
    local newroot
    newroot=$(lsblk -bnro PATH,SIZE,TYPE "$target" 2>/dev/null \
        | awk '$3 == "part" { print $1, $2 }' | sort -k2 -nr | head -1 | awk '{print $1}')
    [[ -n "$newroot" ]] || die "native install produced no root partition on $target"
    log "Migrating /home to the native install on $newroot…"
    mkdir -p "$mnt"; mount "$newroot" "$mnt" || die "cannot mount $newroot"
    local dest="$mnt/home"
    local dep; dep=$(ls -d "$mnt"/ostree/deploy/*/deploy/*.0 2>/dev/null | head -1)
    [[ -n "$dep" ]] && dest="$(dirname "$(dirname "$dep")")/var/home"
    mkdir -p "$dest"
    if command -v rsync >/dev/null; then
        rsync -aHAX /home/ "$dest/" 2>/dev/null || true
    else
        cp -a /home/. "$dest/" 2>/dev/null || true
    fi
    # The bridged Windows folders are fuse binds owned root:root; rsync
    # preserves that, leaving the migrated home unreadable by its own user.
    # Chown to the account (same uid on the fresh install — first user).
    # SELinux contexts are restored on first boot by fisherman's tmpfiles
    # Z line; ownership is ours to fix here.
    if [[ -n "$guser" && -d "$dest/$guser" ]]; then
        chown -R "$(id -u "$guser"):$(id -g "$guser")" "$dest/$guser" \
            || log "WARN: chown of migrated home for $guser failed"
    fi

    # Preserve wootc's machine-specific state in the fresh bootc install.  The
    # E2E-only dispatcher also enables QGA in the native target so the harness
    # can prove it reached this disk, rather than accepting partition creation
    # as a proxy for a successful boot.
    #
    # etcroot, NOT $mnt/etc: on an ostree target $mnt/etc is the SYSROOT etc,
    # which the booted deployment never reads — every write there (native-
    # target, qemu-ga configs, the QGA wants link) silently vanished. The
    # native system booted with guest-exec still blacklisted and the harness
    # called a healthy boot dead (run 20260723T0320, native QGA v10.1.0
    # answering with "guest-exec": enabled=false). The deployment's own etc
    # lives inside $dep.
    local etcroot="$mnt/etc"
    [[ -n "$dep" ]] && etcroot="$dep/etc"
    mkdir -p "$etcroot/wootc"
    cp -a /etc/wootc/. "$etcroot/wootc/" 2>/dev/null || true
    printf '%s\n' "$target" > "$etcroot/wootc/native-target"
    if [[ -x /var/usrlocal/libexec/wootc-e2e-phase3-dispatch ]]; then
        mkdir -p "$etcroot/systemd/system/multi-user.target.wants"
        ln -sf /usr/lib/systemd/system/qemu-guest-agent.service \
            "$etcroot/systemd/system/multi-user.target.wants/qemu-guest-agent.service"
        # A fresh bootc install ships the package-default RPC blacklist
        # (FILTER_RPC_ARGS), which blocks guest-exec — the native system then
        # boots fine but the harness's QGA probe times out and the run reports
        # "did not boot Linux". Mirror the same unfiltered config the deployer
        # writes into Phase 2 (this branch is E2E-only, dispatcher-gated).
        # Content only, never Phase 2's SELinux label: the deployer initramfs
        # wrote these unlabeled, which permissive Phase 2 never notices but
        # the enforcing native system does. Fedora's qemu-ga (virt_qemu_ga_t)
        # reads /etc/qemu/qemu-ga.conf and exits when it cannot, so that file
        # (whose [main] keys qemu-ga ignores anyway) is not copied at all
        # (run 39874539856: bluefin:stable reached GDM, QGA never answered).
        mkdir -p "$etcroot/sysconfig"
        cp /etc/sysconfig/qemu-ga "$etcroot/sysconfig/qemu-ga" 2>/dev/null || true
        # The confined guest agent (virt_qemu_ga_t) cannot read user homes at
        # all — run 20260723T0647: the seed file WAS on the native disk and
        # the harness's direct cat was denied, failing the run on a file that
        # was present. Export the proof to /run at boot from init's
        # unconfined context; the agent is proven able to read /run (that is
        # how the Phase-3 graduation result travels).
        cat > "$etcroot/wootc/e2e-native-probe.sh" <<'PROBE'
#!/bin/bash
# Runs from init's unconfined context at boot; the confined guest agent
# reads only the /run export.
set -Eeuo pipefail
out=/run/wootc-e2e-native-userdata
# A failed new observation must never leave an old successful export.
rm -f -- "$out"
temp=""
trap '[[ -z "$temp" ]] || rm -f -- "$temp"' EXIT
boot=$(cat /proc/sys/kernel/random/boot_id)
[[ "$boot" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]
shopt -s nullglob
files=(/var/home/*/Documents/wootc-e2e-userdata.txt)
[[ ${#files[@]} == 1 ]]
f=${files[0]}
[[ -f "$f" && ! -L "$f" ]]
before=$(stat -Lc '%d:%i:%s:%y:%z' -- "$f")
row=$(findmnt --noheadings --raw --output SOURCE,MAJ:MIN,TARGET --target "$f")
# Raw encoding and extra rows are unsupported, rather than decoded by guess.
[[ "$row" != *$'\n'* && "$row" != *"\\"* ]]
read -r src major target extra <<< "$row"
[[ -z "$extra" && "$src" == /dev/* && "$major" =~ ^[0-9]+:[0-9]+$ && "$target" == /* ]]
temp=$(mktemp "${out}.XXXXXX")
printf 'EXPORT_SCHEMA=1\nEXPORT_BOOT_ID=%s\nSRC=%s\nDATA_MAJ_MIN=%s\nDATA_MOUNT=%s\n' \
    "$boot" "$src" "$major" "$target" > "$temp"
cat -- "$f" >> "$temp"
after=$(stat -Lc '%d:%i:%s:%y:%z' -- "$f")
[[ "$before" == "$after" ]]
chmod 0644 "$temp"
current=$(cat /proc/sys/kernel/random/boot_id)
[[ "$current" == "$boot" ]]
mv -T -- "$temp" "$out"
temp=""
PROBE
        chmod +x "$etcroot/wootc/e2e-native-probe.sh"
        cat > "$etcroot/systemd/system/wootc-e2e-native-probe.service" <<'UNIT'
[Unit]
Description=wootc E2E: export migrated user-data proof to /run
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/bash /etc/wootc/e2e-native-probe.sh

[Install]
WantedBy=multi-user.target
UNIT
        ln -sf ../wootc-e2e-native-probe.service \
            "$etcroot/systemd/system/multi-user.target.wants/wootc-e2e-native-probe.service"
        # The same confinement stops the agent from searching /sysroot/ostree:
        # run 39007144179's native snapshot got no answer from readlink -e for
        # the composefs datadir /sysroot/ostree/repo/objects. The composefs
        # metadata image is mounted detached, so the mount table cannot show
        # where it comes from either. Resolve the root's layers and its
        # ostree deployment from init's context, before the agent starts.
        cat > "$etcroot/wootc/e2e-native-root-probe.sh" <<'ROOTPROBE'
#!/bin/bash
# Runs from init's unconfined context at boot; the confined guest agent
# reads only the /run export. Every value is an observation: one that cannot
# be made fails the whole export, and the harness then refuses.
set -Eeuo pipefail
out=/run/wootc-e2e-native-root
rm -f -- "$out"
temp=""
trap '[[ -z "$temp" ]] || rm -f -- "$temp"' EXIT
plain() { [[ "$1" == /* && "$1" != *[[:space:]\\]* ]]; }
read -r boot < /proc/sys/kernel/random/boot_id
[[ "$boot" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]
# systemd's id for this run of the unit: the probe runs only as a systemd
# unit. (The harness cannot cross-check it: the confined agent cannot read
# /run/systemd/units, run 39886118219.)
invocation=${INVOCATION_ID:-}
[[ "$invocation" =~ ^[0-9a-f]{32}$ ]]
options=$(findmnt --noheadings --raw --output OPTIONS --mountpoint /)
[[ -n "$options" && "$options" != *[[:space:]\\]* ]]
lines=()
IFS=, read -ra parts <<< "$options"
for part in "${parts[@]}"; do
    case "${part%%=*}" in lowerdir|lowerdir+|datadir|datadir+|upperdir|workdir) ;; *) continue ;; esac
    [[ "$part" == *=?* ]]
    value=${part#*=}
    IFS=: read -ra layers <<< "${value//::/:}"
    for layer in "${layers[@]}"; do
        plain "$layer"
        resolved=$(readlink -e -- "$layer")
        plain "$resolved"
        [[ -d "$resolved" ]]
        entry=$(find "$resolved" -mindepth 1 -maxdepth 1 -print -quit)
        if [[ -z "$entry" ]]; then state=empty; else state=populated; fi
        lines+=("LAYER=$layer"$'\t'"$resolved"$'\t'"$state")
    done
done
read -r cmdline < /proc/cmdline
read -ra tokens <<< "$cmdline"
karg=""
for token in "${tokens[@]}"; do
    [[ "$token" == ostree=* ]] || continue
    [[ -z "$karg" ]]
    karg=${token#ostree=}
    plain "$karg"
done
if [[ -n "$karg" ]]; then
    deploy=$(readlink -e -- "/sysroot$karg")
    plain "$deploy"
    [[ -d "$deploy" ]]
    lines+=("DEPLOY=$karg"$'\t'"$deploy")
    image="$deploy/.ostree.cfs"
    if [[ -e "$image" || -L "$image" ]]; then
        [[ -f "$image" && ! -L "$image" ]]
        device=$(stat -c '%Hd:%Ld' -- "$image")
        [[ "$device" =~ ^[0-9]+:[0-9]+$ ]]
        lines+=("IMAGE=$image"$'\t'"$device")
    fi
fi
temp=$(mktemp "${out}.XXXXXX")
{
    printf 'ROOT_SCHEMA=1\nROOT_BOOT_ID=%s\nROOT_INVOCATION=%s\nROOT_OPTIONS=%s\n' "$boot" "$invocation" "$options"
    [[ ${#lines[@]} -eq 0 ]] || printf '%s\n' "${lines[@]}"
} > "$temp"
chmod 0644 "$temp"
read -r current < /proc/sys/kernel/random/boot_id
[[ "$current" == "$boot" ]]
mv -T -- "$temp" "$out"
temp=""
ROOTPROBE
        chmod +x "$etcroot/wootc/e2e-native-root-probe.sh"
        # Before= the agent: the harness snapshots as soon as the agent
        # answers, so the export must already exist. A failed probe still
        # lets the agent start; the missing export then refuses the run.
        cat > "$etcroot/systemd/system/wootc-e2e-native-root-probe.service" <<'UNIT'
[Unit]
Description=wootc E2E: export native root layer observations to /run
After=local-fs.target
Before=qemu-guest-agent.service

[Service]
Type=oneshot
# A oneshot has no start timeout by default; a hung probe must not hold
# the guest agent (ordered after it) back forever.
TimeoutStartSec=60
# Stay active so a later start in the same boot does not run it again.
RemainAfterExit=yes
ExecStart=/bin/bash /etc/wootc/e2e-native-root-probe.sh

[Install]
WantedBy=multi-user.target
UNIT
        ln -sf ../wootc-e2e-native-root-probe.service \
            "$etcroot/systemd/system/multi-user.target.wants/wootc-e2e-native-root-probe.service"
        # The generic post-boot health check cannot run through the agent
        # either: on the enforcing native system every systemctl call from
        # virt_qemu_ga_t answered "Failed to retrieve unit state: Access
        # denied" (probe 44833993709), so the gate saw no boot state, no
        # D-Bus and no display manager on a system that had booted. The
        # harness stages the check (tests/e2e/phase3-health.sh) and its
        # Phase-2 baseline in /run before graduation; run them here from
        # init's context and export the verdict to /run. Plain cp: the
        # native policy labels them as its own /etc/wootc files.
        local staged
        for staged in e2e-phase3-health.sh e2e-phase3-health.baseline; do
            if [[ -f "/run/wootc-$staged" ]]; then
                cp "/run/wootc-$staged" "$etcroot/wootc/$staged" \
                    || log "WARN: could not copy the staged $staged into the native install"
            fi
        done
        cat > "$etcroot/wootc/e2e-native-health.sh" <<'HEALTHPROBE'
#!/bin/bash
# Runs from init's unconfined context at boot; the confined guest agent
# reads only the /run export. The check waits for the boot to finish
# itself, so this unit must not hold the boot transaction (Type=exec).
set -Eeuo pipefail
out=/run/wootc-e2e-native-health
check=/etc/wootc/e2e-phase3-health.sh
rm -f -- "$out"
temp=""
trap '[[ -z "$temp" ]] || rm -f -- "$temp"' EXIT
read -r boot < /proc/sys/kernel/random/boot_id
[[ "$boot" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]
status=0
if [[ -f "$check" ]]; then
    baseline=$(cat /etc/wootc/e2e-phase3-health.baseline 2>/dev/null || true)
    output=$(/bin/sh "$check" check "$baseline" 2>&1) || status=$?
else
    status=127
    output="no health check at $check: the harness did not stage it before graduation"
fi
temp=$(mktemp "${out}.XXXXXX")
printf 'HEALTH_SCHEMA=1\nHEALTH_BOOT_ID=%s\nHEALTH_STATUS=%s\n%s\n' \
    "$boot" "$status" "$output" > "$temp"
chmod 0644 "$temp"
read -r current < /proc/sys/kernel/random/boot_id
[[ "$current" == "$boot" ]]
mv -T -- "$temp" "$out"
temp=""
HEALTHPROBE
        chmod +x "$etcroot/wootc/e2e-native-health.sh"
        # Type=exec: the start job completes once the script runs, so the
        # boot can finish while the check waits for it. RuntimeMaxSec bounds
        # a hung check; the harness then finds no export and refuses.
        cat > "$etcroot/systemd/system/wootc-e2e-native-health.service" <<'UNIT'
[Unit]
Description=wootc E2E: export the post-boot health check to /run
After=local-fs.target

[Service]
Type=exec
RuntimeMaxSec=900
ExecStart=/bin/bash /etc/wootc/e2e-native-health.sh

[Install]
WantedBy=multi-user.target
UNIT
        ln -sf ../wootc-e2e-native-health.service \
            "$etcroot/systemd/system/multi-user.target.wants/wootc-e2e-native-health.service"
    fi
    # Label everything graduation wrote with the target's own policy, as the
    # deployer does for Phase 2. fisherman's offline useradd rewrites passwd,
    # group and shadow as plain etc_t, and the /home copy above keeps Phase
    # 2's labels (/var/home/linuxbrew stayed home_root_t). Probe 44843263310:
    # 5943 such paths under /etc and /var/home on the enforcing native
    # system, and init_t was denied creating /var/lib/systemd/random-seed in
    # a var_t directory. setfiles, not restorecon: it applies the given
    # file_contexts with -r rooting the paths at the deployment/stateroot.
    if [[ -n "$dep" ]]; then
        local fc stateroot
        stateroot=$(dirname "$(dirname "$dep")")
        fc=$(ls "$dep"/etc/selinux/*/contexts/files/file_contexts 2>/dev/null | head -1)
        if [[ -n "$fc" ]]; then
            if ! command -v setfiles >/dev/null \
                || ! setfiles -F -r "$dep" "$fc" "$dep/etc" \
                || ! setfiles -F -r "$stateroot" "$fc" "$stateroot/var"; then
                umount "$mnt" 2>/dev/null || true
                die "could not apply the native system's SELinux labels to $dep/etc and $stateroot/var; the native boot is not scheduled"
            fi
            log "Applied the native system's SELinux labels to /etc and /var"
        fi
    fi
    sync; umount "$mnt" 2>/dev/null || true

    # fisherman already created a UEFI boot entry for the new disk. Schedule it
    # as the next-boot entry (BootNext) so the first reboot lands on the native
    # install without permanently changing BootOrder. Find the entry by the
    # TARGET ESP's PARTUUID in its device path — an observable — never by
    # label: fisherman named its entry without the word "Linux", the old
    # label grep matched nothing, and the "fisherman set the EFI boot order"
    # fallback trusted a BootOrder that still had Windows first (run
    # 20260723T0215: graduation green, reboot landed in Windows).
    local esp_part espuuid bootnum
    esp_part=$(lsblk -nro PATH,TYPE "$target" | awk '$2=="part"{print $1; exit}')
    espuuid=$(blkid -s PARTUUID -o value "$esp_part" 2>/dev/null || true)
    bootnum=""
    if [[ -n "$espuuid" ]]; then
        bootnum=$(efibootmgr -v 2>/dev/null | grep -i "$espuuid" \
            | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p' | tail -1)
    fi
    [[ -n "$bootnum" ]] || bootnum=$(efibootmgr 2>/dev/null \
        | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\}.*Linux.*/\1/p' | tail -1)
    [[ -n "$bootnum" ]] || die "no UEFI entry matches $target (ESP $esp_part PARTUUID ${espuuid:-unknown}) — refusing to claim success without a schedulable native boot"
    efibootmgr -n "$bootnum" >/dev/null \
        || die "could not set BootNext Boot$bootnum — native boot would be unverifiable"
    log "Graduate complete. Scheduled Boot$bootnum (ESP $espuuid) for next reboot."
    log "Reboot to run natively from $target. Windows + root.disk remain for rollback."
}

# ── migrate ──────────────────────────────────────────────────────────────────
# Default is a DRY RUN: print the exact command plan and stop. Real execution
# is gated behind --execute + WOOTC_GN_ALLOW_DESTRUCTIVE=1 + preconditions and
# is intentionally not enabled until validated against a booted Phase-2 system
# (rung 3): a repartition bug must never run blind against a user's disk.
cmd_migrate() {
    local mode="" execute=false to_disk=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dual-boot) mode="dual-boot" ;;
            --reclaim)   mode="reclaim" ;;
            --to-disk)   mode="dual-boot"; to_disk="$2"; shift ;;
            --execute|--i-understand) execute=true ;;
            *) die "unknown migrate arg: $1" ;;
        esac
        shift
    done
    [[ -n "$mode" ]] || die "choose --dual-boot [--to-disk DEV] (keep Windows) or --reclaim (delete Windows)"

    if ! discover_layout; then
        die "could not locate the Windows disk/NTFS (need $HOSTCONF or WOOTC_GN_DISK/NTFS)"
    fi

    # Reclaim's hard data-safety gate: never delete Windows while data still
    # lives only there. Running native + converted folders are preconditions.
    if [[ "$mode" == "reclaim" ]]; then
        if on_loopback; then
            die "refusing --reclaim: still running from root.disk. Run --dual-boot and reboot native first."
        fi
        [[ "$(converted_folders | wc -l)" -gt 0 ]] \
            || die "refusing --reclaim: no folders verified native (see 'check'). Convert your data first."
    fi

    echo "── DRY RUN ─────────────────────────────────────────────────────────"
    [[ "$mode" == "dual-boot" ]] && graduate_plan || reclaim_plan
    echo "────────────────────────────────────────────────────────────────────"

    if [[ "$execute" != true ]]; then
        echo "Dry run only. Re-run with --execute to perform these steps."
        return 0
    fi
    # These are disposable-VM test targets, but keep the flag so a stray
    # --execute on a real box (no flag set) can't repartition it.
    if [[ "${WOOTC_GN_ALLOW_DESTRUCTIVE:-0}" != "1" ]]; then
        die "--execute requires WOOTC_GN_ALLOW_DESTRUCTIVE=1 (set only in the test harness)"
    fi
    # The implemented, testable execution path: graduate onto a spare target
    # disk (bootc install to-disk from the local image). Same-disk shrink/reclaim
    # runs from a graduate-deployer and is wired separately.
    if [[ -n "$to_disk" ]]; then
        graduate_to_disk_execute "$to_disk"
        return 0
    fi
    die "in-place (shrink Windows) graduate runs from the graduate-deployer; use --to-disk DEV for the spare-drive path"
}

# ── status --json ────────────────────────────────────────────────────────────
# Machine-readable state for the GUI (wootc-go-native-gui). Read-only and safe
# to run anywhere; every field mirrors what `plan`/`check` print as text.
cmd_status() {
    local src loop hostuuid bootloader snapshot hostconf reclaim_ok
    src=$(root_source)
    on_loopback && loop=1 || loop=0
    hostuuid=""; bootloader=""; hostconf=0
    if [[ -r "$HOSTCONF" ]]; then
        hostuuid=$(grep -oP 'HOST_ESP_UUID=\K.*' "$HOSTCONF" 2>/dev/null || true)
        bootloader=$(grep -oP 'BOOTLOADER=\K.*' "$HOSTCONF" 2>/dev/null || true)
        hostconf=1
    fi
    if command -v btrfs >/dev/null && btrfs subvolume show / >/dev/null 2>&1; then snapshot=1; else snapshot=0; fi
    # reclaim is offered only once native (off loopback) AND at least one folder
    # is verified native — the same hard gate cmd_migrate enforces.
    local nconv; nconv=$(converted_folders | grep -c . || true)
    if [[ "$loop" == 0 && "${nconv:-0}" -gt 0 ]]; then reclaim_ok=1; else reclaim_ok=0; fi

    # Non-destructive NTFS shrink analysis for the GUI (Phase 3-A).
    local shrink_ok=0 shrink_gib=0 shrink_diag=""
    if [[ "$loop" == 1 ]] && discover_layout; then
        local shrink_result
        shrink_result=$(check_shrinkable "$NTFS_DEV" 2>&1 || true)
        if [[ "$shrink_result" == "[ok]"* ]]; then
            shrink_ok=1
            shrink_gib=$(echo "$shrink_result" | grep -oP '[0-9]+(?= GiB available)' | head -1)
            shrink_gib=$(( shrink_gib > 4 ? shrink_gib - 2 : shrink_gib ))
        fi
        shrink_diag="$shrink_result"
    fi

    GN_SRC="$src" GN_LOOP="$loop" GN_UUID="$hostuuid" GN_BL="$bootloader" \
    GN_HOSTCONF="$hostconf" GN_SNAP="$snapshot" GN_RECLAIM="$reclaim_ok" \
    GN_FOLDERS="$(converted_folders | paste -sd, - 2>/dev/null || true)" \
    GN_SHRINK_OK="$shrink_ok" GN_SHRINK_GIB="$shrink_gib" GN_SHRINK_DIAG="$shrink_diag" \
    python3 - <<'PY'
import json, os
folders = [f for f in os.environ.get("GN_FOLDERS", "").split(",") if f]
print(json.dumps({
    "onLoopback":      os.environ["GN_LOOP"] == "1",
    "rootSource":      os.environ.get("GN_SRC", "") or None,
    "hostEspUuid":     os.environ.get("GN_UUID", "") or None,
    "hostBootloader":  os.environ.get("GN_BL", "") or None,
    "convertedFolders": folders,
    "gates": {
        "hostLayoutRecorded": os.environ["GN_HOSTCONF"] == "1",
        "snapshotCapable":    os.environ["GN_SNAP"] == "1",
        "dataIsNative":       len(folders) > 0,
        "ntfsShrinkable":     os.environ.get("GN_SHRINK_OK", "0") == "1",
    },
    "canGraduate": os.environ["GN_LOOP"] == "1",
    "canReclaim":  os.environ["GN_RECLAIM"] == "1",
    "shrink": {
        "safeGib":  int(os.environ.get("GN_SHRINK_GIB", "0") or "0"),
        "ok":       os.environ.get("GN_SHRINK_OK", "0") == "1",
        "diag":     os.environ.get("GN_SHRINK_DIAG", "") or None,
    },
}, indent=2))
PY
}

# Sourced (tests): define the functions only.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

case "${1:-plan}" in
    plan)    shift 2>/dev/null || true; cmd_plan "$@" ;;
    check)   shift; cmd_check "$@" ;;
    status)  shift; cmd_status "$@" ;;
    migrate) shift; cmd_migrate "$@" ;;
    # Internal: native_install_staged runs the staged install as a child process.
    __staged-install) shift; cmd_staged_install "$@" ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown subcommand: $1 (plan|check|status|migrate)" ;;
esac

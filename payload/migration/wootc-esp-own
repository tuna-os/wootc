#!/bin/bash
# Source from the deployer. Actual Phase1 manifest precedes every new ESP file.
esp_normalize_owned_path() {
    local value="$1"
    value="${value//$'\r'/}"
    value="${value#$'\xef\xbb\xbf'}"
    value="${value//\\//}"
    value="${value,,}"
    [[ "$value" != /* && "$value" != *:* && "$value" != *//* &&
       "/$value/" != */../* && "/$value/" != */./* && -n "$value" ]] || return 1
    printf '%s\n' "$value"
}

esp_path_is_owned() {
    local esp="$1" wanted="$2" line normalized
    wanted=$(esp_normalize_owned_path "$wanted") || return 1
    [[ -f "$esp/EFI/wootc/wootc-owned.txt" && ! -L "$esp/EFI/wootc/wootc-owned.txt" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        [[ -n "$line" ]] || continue
        normalized=$(esp_normalize_owned_path "$line") || return 1
        [[ "$normalized" != "$wanted" ]] || return 0
    done < "$esp/EFI/wootc/wootc-owned.txt"
    return 1
}

# EFI/wootc and loader/entries/wootc.conf are wootc's by name: nothing else
# writes there. A wootc install that predates the manifest left them behind
# unclaimed, and refusing them would block that install's own reinstall. The
# Windows installer's guard (app/esp_ownership.go isOwnNamespace) already
# treats EFI/wootc this way; shared vendor directories still need a claim.
esp_path_is_own_namespace() {
    local value
    value=$(esp_normalize_owned_path "$1") || return 1
    [[ "$value" == efi/wootc/* && "$value" != efi/wootc/wootc-owned.txt ]] ||
        [[ "$value" == loader/entries/wootc.conf ]]
}

# A grub.cfg carrying the "# wootc" marker family means wootc staged the
# shared EFI/fedora tree: an installer that predates the manifest, and the
# scripted Phase 1 (setup-wootc.ps1), stage it without claims. Same rule as
# app/esp_ownership.go ownsFedoraNamespace; no other vendor tree gets it.
esp_fedora_tree_is_wootc() {
    local esp="$1"
    [[ -f "$esp/EFI/fedora/grub.cfg" && ! -L "$esp/EFI/fedora/grub.cfg" ]] &&
        grep -q '# wootc' "$esp/EFI/fedora/grub.cfg"
}

# The deployer runs after a Phase 1 that may have written no manifest (see
# above). The manifest lives in wootc's own namespace, so an absent one is
# started empty and every later claim is recorded in it.
esp_ensure_manifest() {
    local esp="$1"
    [[ ! -L "$esp/EFI/wootc/wootc-owned.txt" ]] || return 1
    [[ -f "$esp/EFI/wootc/wootc-owned.txt" ]] && return 0
    mkdir -p "$esp/EFI/wootc" && : > "$esp/EFI/wootc/wootc-owned.txt" &&
        sync -f "$esp/EFI/wootc"
}

esp_assert_owned_or_absent() {
    local esp="$1" relative="$2" normalized
    normalized=$(esp_normalize_owned_path "$relative") || return 1
    [[ -f "$esp/EFI/wootc/wootc-owned.txt" && ! -L "$esp/EFI/wootc/wootc-owned.txt" ]] || return 1
    [[ ! -e "$esp/$relative" && ! -L "$esp/$relative" ]] && return 0
    [[ ! -L "$esp/$relative" ]] || return 1
    esp_path_is_own_namespace "$relative" && return 0
    [[ "$normalized" == efi/fedora/* ]] && esp_fedora_tree_is_wootc "$esp" && return 0
    esp_path_is_owned "$esp" "$relative"
}

esp_claim_before_write() {
    local esp="$1" relative="$2" temporary normalized
    esp_assert_owned_or_absent "$esp" "$relative" || {
        printf '[wootc] refusing foreign/unowned ESP path: %s\n' "$relative" >&2
        return 1
    }
    esp_path_is_owned "$esp" "$relative" && return 0
    normalized=$(esp_normalize_owned_path "$relative") || return 1
    temporary=$(mktemp "$esp/EFI/wootc/.owned-XXXXXX") || return 1
    if ! { cat "$esp/EFI/wootc/wootc-owned.txt"; printf '\n%s\n' "$normalized"; } > "$temporary" ||
       ! sync -f "$temporary" || ! mv -f "$temporary" "$esp/EFI/wootc/wootc-owned.txt" ||
       ! sync -f "$esp/EFI/wootc"; then
        rm -f "$temporary"
        return 1
    fi
}

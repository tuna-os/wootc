#!/bin/bash
# /usr/local/bin/wootc-convert-dir <username> <Folder>
# Stage-4 conversion (SPEC §4.2): copy one bridged Windows folder to
# native Linux storage and replace the bind mount with the local copy.
# Root-only (invoked from the migration dashboard via pkexec).
#
# Reversible by design: the Windows originals are never touched — until
# the user removes Windows (stage 6), the data exists in both places.
#
# Progress protocol: emits "PROGRESS <0-100>" lines on stdout so the
# dashboard can render a real progress bar (parsed from rsync -P output).

set -Eeuo pipefail

log() { printf '[wootc-convert-dir] %s\n' "$*"; }
name="${1:?usage: wootc-convert-dir <username> <Folder>}"
folder="${2:?usage: wootc-convert-dir <username> <Folder>}"

case "$folder" in
    Documents|Pictures|Downloads|Music|Videos|Desktop) ;;
    *) log "ERROR: unsupported folder '$folder'"; exit 2 ;;
esac

home=$(getent passwd "$name" | cut -d: -f6)
[[ -d "$home" ]] || { log "ERROR: no home for $name"; exit 1; }
dst="$home/$folder"
staging="$home/.wootc-convert-$folder.partial"

# An existing native folder can contain work from an earlier conversion or
# files hidden beneath the bind mount. Never merge/nest the staging copy into
# it and then claim the Windows folder was converted.
if ! mountpoint -q "$dst" 2>/dev/null && [[ -e "$dst" || -L "$dst" ]]; then
    [[ -d "$dst" && ! -L "$dst" ]] || { log "ERROR: destination is not a native directory"; exit 2; }
    [[ -z "$(find "$dst" -mindepth 1 -maxdepth 1 -print -quit)" ]] || {
        log "ERROR: $dst already contains Linux files; preserving your work"
        exit 2
    }
fi

# Resolve the real Windows source path. The default below assumes the
# Linux username matches the Windows profile name, but the single-user
# fallback in wootc-mount-user-dirs may have bridged a profile with a
# different name. When $dst is already a bind mount, trust the kernel's
# mount table over the constructed path (#73).
src="/run/wootc/host/Users/$name/$folder"
if [[ ! -d "$src" ]] && mountpoint -q "$dst" 2>/dev/null; then
    resolved=$(findmnt -n -o SOURCE "$dst" 2>/dev/null || true)
    if [[ -n "$resolved" && -d "$resolved" ]]; then
        log "$src not found; using bind-mount source $resolved (#73 fallback)"
        src="$resolved"
    fi
fi

[[ -d "$src" ]] || { log "ERROR: source $src not found"; exit 1; }

# 0. Guard: refuse to convert an empty source — silent no-op migrations
#    mislead the user into believing their data arrived (#73).
file_count=$(find "$src" -maxdepth 1 -mindepth 1 ! -name 'desktop.ini' ! -name 'Thumbs.db' 2>/dev/null | wc -l)
if [[ "$file_count" -eq 0 ]]; then
    log "ERROR: $src exists but is empty (no files to migrate) — nothing to convert"
    exit 2
fi

# 1. Copy Windows → native staging (resumable on re-run).
#
# --safe-links + Windows-cruft excludes: a Windows user profile is full of
# NTFS reparse junctions for XP-era path compatibility — Documents\My Music
# -> ..\Music, Documents\My Pictures, Desktop desktop.ini, and the infamous
# self-referential AppData\Local\Application Data -> AppData\Local loop.
# ntfs-3g exposes these as symlinks; a plain `rsync -a` would either copy
# them as symlinks DANGLING at Windows paths that don't exist on Linux, or
# (on a deeper tree) recurse the self-junction. --safe-links drops any
# symlink pointing outside the copied folder (exactly these junctions), and
# the excludes drop system files a Linux user should never see. This is the
# "handle named pipes / directory order" class of edge case migration tools
# all eventually hit.
RSYNC_SAFE=(-a --safe-links
    --exclude 'desktop.ini' --exclude 'Thumbs.db' --exclude 'ehthumbs.db'
    --exclude '$RECYCLE.BIN' --exclude 'System Volume Information'
    --exclude '*:Zone.Identifier')
mkdir -p "$staging"
total_kb=$(du -sk --exclude='System Volume Information' "$src" 2>/dev/null | cut -f1)
rsync "${RSYNC_SAFE[@]}" --info=progress2 "$src/" "$staging/" | \
    stdbuf -oL grep -oP '\d+(?=%)' | \
    while read -r pct; do echo "PROGRESS $pct"; done || true
# rsync exit status is lost in the pipe; verify by re-running quietly —
# a clean second pass is cheap and proves completeness.
rsync "${RSYNC_SAFE[@]}" --quiet "$src/" "$staging/"
echo "PROGRESS 100"

# 2. Swap: unbind the Windows folder, move the native copy into place.
if mountpoint -q "$dst"; then
    umount "$dst"
fi
# The mountpoint may expose pre-existing native files after unmount. A failed
# removal must stop the conversion, retaining both those files and staging.
if [[ -e "$dst" || -L "$dst" ]]; then
    [[ -d "$dst" && ! -L "$dst" ]] || { log "ERROR: unsafe destination after unmount"; exit 2; }
    rmdir -- "$dst" || { log "ERROR: native destination is not empty; conversion stopped"; exit 2; }
fi
# -T forbids nesting if another directory appears after the empty check.
mv -T -- "$staging" "$dst"
chown -R "$name:" "$dst"

# 3. Record the conversion so wootc-mount-user-dirs stops bridging it.
state_dir="$home/.config/wootc"
mkdir -p "$state_dir"
touch "$state_dir/converted-$folder"
chown -R "$name:" "$state_dir"

log "converted $folder for $name (${total_kb:-?} KB) — Windows copy untouched"

#!/bin/bash
# /usr/local/bin/wootc-mount-user-dirs
# Bind-mounts Windows user-profile folders (Documents, Pictures, Downloads,
# Music, Videos, Desktop) into the matching Linux user's home directory.
# Runs as wootc-passthrough.service, after wootc-host-bind.service has
# bound the Windows NTFS partition at /run/wootc/host.
#
# Matching is by exact username: the Linux account fisherman created from
# vault.json is expected to share its name with the Windows profile under
# /run/wootc/host/Users/<name>/. A user with no matching Windows profile is skipped
# (not an error — native installs with no prior Windows account are normal).
#
# EXCEPT for the single-user case. Exact matching alone meant that a user who
# typed ANY new Linux username — a different capitalisation, a shorter handle, a
# fresh name for their fresh OS — got a successful migration that carried none of
# their files (#73; found on Enterprise media, whose Windows profile is "Docker"
# while the installer created "wootc"). When there is exactly ONE real Windows
# profile and exactly ONE real Linux account, and no name matched, there is no
# ambiguity about whose data this is: bridge it. With several profiles the names
# are the only signal available, so exact matching still governs.

set -Eeuo pipefail
HOST="${WOOTC_HOST:-/run/wootc/host}"

log() { printf '[wootc-passthrough] %s\n' "$*"; }
warn() { printf '[wootc-passthrough] WARNING: %s\n' "$*" >&2; }

FOLDERS=(Documents Pictures Downloads Music Videos Desktop)

if ! mountpoint -q "$HOST"; then
    log "ERROR: $HOST is not mounted (wootc-host-bind.service did not run first)"
    exit 1
fi

# ── BitLocker: encrypted C: unlock (#61) ───────────────────────────────────
# On a BitLocker-protected machine the host mount is the UNENCRYPTED data
# volume (E:), which holds root.disk but NOT the user profiles. Those live on
# the encrypted C:, which the Phase-2 boot does not unlock by default.
#
# When the normal profile search finds nothing, look for the BitLocker recovery
# key (Phase 1 writes it to \wootc\install\bitlocker-key.txt; the deployer
# moves it to /etc/wootc/bitlocker-key) and unlock C: with cryptsetup bitlkOpen.
# On success the bridge reads profiles from the unlocked volume; on failure
# (missing key, no cryptsetup, wrong key) it logs a clear diagnostic so the
# user knows WHY their data did not arrive.
BITLOCKER_PROFILES=""
WOOTC_ETC="${WOOTC_ETC:-/etc/wootc}"

# Prints the recovery key file the bridge should use, best first:
#   /etc/wootc/bitlocker-key       plaintext: the deployer's copy before it is
#                                  sealed, or one the user saved to recover
#   /etc/wootc/bitlocker-key.cred  sealed to this machine (systemd-creds)
#   \wootc\install\bitlocker-key.txt on NTFS: deployments made before the
#                                  deployer moved the key (#279)
# Nothing here deletes the key: it is needed on every boot while any folder
# is still bridged, and wootc-convert-dir retires it.
bitlocker_key_file() {
    local candidate
    for candidate in "$WOOTC_ETC/bitlocker-key" "$WOOTC_ETC/bitlocker-key.cred"; do
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    for candidate in "$HOST"/wootc/install/bitlocker-key.txt \
                     "$HOST"/*/wootc/install/bitlocker-key.txt; do
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

# Seals a plaintext key to this machine, then shreds the plaintext (#279).
# --with-key=auto uses the TPM2 and the host key when a TPM2 is present, and
# the host key alone otherwise. --tpm2-pcrs= binds to the TPM itself, not to
# the boot state: a firmware or Secure Boot update must not lock the user out
# of their own folders, while a copy of the disk still cannot be unsealed on
# another machine. The plaintext goes only after the sealed copy decrypts to
# the same bytes; on any failure it stays, and the next boot tries again.
seal_bitlocker_key() {
    local key="$WOOTC_ETC/bitlocker-key" cred="$WOOTC_ETC/bitlocker-key.cred" want
    [[ -f "$key" ]] || return 0
    if ! command -v systemd-creds >/dev/null 2>&1; then
        log "systemd-creds not available — the BitLocker recovery key stays in ${key} (root only), not sealed"
        return 0
    fi
    want=$(sha256sum < "$key") || return 0
    rm -f "$cred.partial"
    # Some systemd builds refuse an empty PCR list without a TPM; their
    # default policy is the fallback, never the plaintext staying forever.
    if { ( umask 077 && systemd-creds encrypt --with-key=auto --tpm2-pcrs= --name=bitlocker-key "$key" "$cred.partial" ) 2>/dev/null ||
         ( umask 077 && systemd-creds encrypt --with-key=auto --name=bitlocker-key "$key" "$cred.partial" ) 2>/dev/null; } &&
       [[ "$(systemd-creds decrypt --name=bitlocker-key "$cred.partial" - 2>/dev/null | sha256sum)" == "$want" ]] &&
       mv -f "$cred.partial" "$cred"; then
        shred -u "$key" 2>/dev/null || rm -f "$key"
        log "BitLocker recovery key sealed to this machine (${cred}); plaintext copy shredded"
        return 0
    fi
    rm -f "$cred.partial"
    warn "could not seal the BitLocker recovery key — it stays in ${key} (root only); sealing is retried on the next boot"
    return 0
}

# Prints the key file's contents. A sealed key is decrypted in memory; it is
# never written back to disk.
bitlocker_key_material() {
    if [[ "$1" == *.cred ]]; then
        systemd-creds decrypt --name=bitlocker-key "$1" - 2>/dev/null
    else
        cat -- "$1"
    fi
}

# Prints the recovery password in the only form cryptsetup's BITLK code
# accepts as one: eight groups of six digits joined by hyphens (55 chars).
# The 48 bare digits are a different passphrase that never unlocks the
# recovery protector (cryptsetup: "No key available with this passphrase").
# Phase 1 stores the digits without hyphens and the E2E fixture stores them
# with, so both are read: keep only the digits, require exactly 48, check each
# group the way BitLocker does (a multiple of 11 below 65536 * 11), and put the
# hyphens back. Anything else is refused rather than guessed at.
bitlocker_recovery_password() {
    local digits group value i out=""
    if [[ "${1:--}" == - ]]; then
        digits=$(tr -cd '0-9') || return 1
    else
        digits=$(tr -cd '0-9' < "$1" 2>/dev/null) || return 1
    fi
    [[ ${#digits} -eq 48 ]] || return 1
    for ((i = 0; i < 48; i += 6)); do
        group=${digits:i:6}
        value=$((10#$group))
        (( value % 11 == 0 && value / 11 <= 65535 )) || return 1
        out+="${out:+-}$group"
    done
    printf '%s' "$out"
}

find_bitlocker_profiles() {
    # Only proceed if the host mount itself has no Users/ (the BitLocker
    # signature). If Users exists, this is not the encrypted-C: path.
    [[ -d $HOST/Users ]] && return 0

    # cryptsetup with bitlk support is required.
    command -v cryptsetup >/dev/null 2>&1 || { log "cryptsetup not available — cannot unlock BitLocker volumes"; return 0; }
    cryptsetup --help 2>&1 | grep -q bitlkOpen || { log "cryptsetup lacks bitlk support — cannot unlock BitLocker volumes"; return 0; }

    # Seal a plaintext copy first, then find the best copy (#279).
    seal_bitlocker_key
    local key_file=""
    if ! key_file=$(bitlocker_key_file); then
        log "no BitLocker recovery key found (expected ${WOOTC_ETC}/bitlocker-key, or \\wootc\\install\\bitlocker-key.txt on the host mount)"
        log "profiles are on an encrypted C: drive which cannot be unlocked without the recovery key"
        return 0
    fi
    if [[ "$key_file" == *.cred ]]; then
        log "BitLocker recovery key found sealed at ${key_file} — attempting encrypted C: unlock"
    elif [[ "$key_file" == "$WOOTC_ETC/"* ]]; then
        log "BitLocker recovery key found at ${key_file} — attempting encrypted C: unlock"
    else
        log "BitLocker recovery key found at ${key_file} (legacy NTFS copy) — attempting encrypted C: unlock"
    fi

    # Find BitLocker-encrypted volumes on the system.
    local bl_vol="" dev fstype
    for dev in /dev/sd*[0-9] /dev/nvme*n*p* /dev/vd*[0-9]; do
        [[ -b "$dev" ]] || continue
        fstype=$(blkid -o value -s TYPE "$dev" 2>/dev/null || true)
        if [[ "$fstype" == "BitLocker" ]]; then
            bl_vol="$dev"
            break
        fi
    done
    if [[ -z "$bl_vol" ]]; then
        log "no BitLocker-encrypted volume found on the system — profiles are not here"
        return 0
    fi
    log "found BitLocker-encrypted volume: ${bl_vol}"

    # A sealed key that will not decrypt (the TPM was cleared, or the disk
    # moved to another machine) must never look like missing folders. Say
    # what happened and how the user gets their folders back.
    local key_material
    if ! key_material=$(bitlocker_key_material "$key_file"); then
        warn "the saved BitLocker recovery key (${key_file}) cannot be unsealed on this machine — for example after the TPM was cleared"
        warn "your Windows folders are still on the Windows drive: they are not lost"
        warn "to reach them again, save your own 48-digit BitLocker recovery key as ${WOOTC_ETC}/bitlocker-key (readable by root only) and restart; it is sealed again on the next start"
        return 0
    fi

    # cryptsetup accepts a recovery password only in its canonical form.
    local recovery_key
    if ! recovery_key=$(printf '%s' "$key_material" | bitlocker_recovery_password -); then
        unset key_material
        warn "BitLocker recovery key in ${key_file} is not a valid 48-digit recovery password — refusing unlock"
        return 0
    fi
    unset key_material

    # Unlock and mount the BitLocker volume.
    local mapper="wootc-bitlk-$$"
    local mnt="/run/wootc/bitlk-tmp"
    mkdir -p "$mnt"
    if ! printf '%s' "$recovery_key" | cryptsetup bitlkOpen "$bl_vol" "$mapper" --key-file=- 2>/dev/null; then
        warn "cryptsetup bitlkOpen failed for ${bl_vol} — recovery key may be stale or volume is not BitLocker"
        rmdir "$mnt" 2>/dev/null || true
        return 0
    fi
    log "BitLocker volume ${bl_vol} unlocked as /dev/mapper/${mapper}"

    # Mount read-only — we only need to read profiles, never write.
    if ! mount -t ntfs3 -o ro "/dev/mapper/${mapper}" "$mnt" 2>/dev/null && \
       ! mount -t ntfs-3g -o ro "/dev/mapper/${mapper}" "$mnt" 2>/dev/null; then
        warn "could not mount unlocked BitLocker volume — NTFS driver issue"
        cryptsetup close "$mapper" 2>/dev/null || true
        rmdir "$mnt" 2>/dev/null || true
        return 0
    fi
    log "unlocked BitLocker volume mounted at ${mnt}"

    # Check if this volume actually contains user profiles.
    if [[ -d "${mnt}/Users" ]]; then
        BITLOCKER_PROFILES="$mnt"
        log "BitLocker C: unlocked — user profiles found at ${mnt}/Users/"
    else
        warn "unlocked BitLocker volume does not contain Users/ — not the C: drive"
        umount "$mnt" 2>/dev/null || true
        cryptsetup close "$mapper" 2>/dev/null || true
        rmdir "$mnt" 2>/dev/null || true
    fi
}

# Honour the user's choices from the migration chooser (wootc-manifest-gui).
# sel_on <user> <category> -> 0 when that category should be migrated.
sel_on() {
    command -v wootc-selection >/dev/null || return 0   # helper absent: migrate
    local rc=0
    wootc-selection "$1" "$2" >/dev/null 2>&1 || rc=$?
    # Only an explicit rc=1 means "off"; a broken/unrunnable helper migrates.
    [ "$rc" -eq 1 ] && return 1
    return 0
}

bound=0
copied=0
matched=0

# Known-folder redirection (#64). Windows 11's OOBE pushes "OneDrive Backup",
# which REDIRECTS Desktop/Documents/Pictures to %USERPROFILE%\OneDrive\<folder>.
# On such a machine the literal <profile>/Documents is empty or a stub, so
# binding it faithfully presents the user with an empty Documents folder while
# every file sits safely on the disk a few directories away.
#
# Only Windows can read its own registry, so Phase 1 resolves the real paths and
# leaves them in <wootc>/known-folders.json. Read that when present; otherwise
# fall back to the literal layout, which is exactly the pre-#64 behaviour.
KNOWN_FOLDERS=""
for candidate in "$HOST"/wootc/known-folders.json "$HOST"/*/wootc/known-folders.json; do
    [[ -f "$candidate" ]] && { KNOWN_FOLDERS="$candidate"; break; }
done
[[ -n "$KNOWN_FOLDERS" ]] && log "known-folder manifest: $KNOWN_FOLDERS"

# win_to_host <windows-path> — translate "C:\Users\u\OneDrive\Documents" to
# its place under the mounted Windows volume. The drive letter is dropped:
# /run/wootc/host IS that volume, whatever letter Windows called it.
win_to_host() {
    local p="${1//\\//}"
    local drive=""
    if [[ "$p" =~ ^([A-Za-z]): ]]; then
        drive="${BASH_REMATCH[1]}"
        p="${p:2}"
    fi
    if [[ "${drive^^}" == C && -n "$BITLOCKER_PROFILES" ]]; then
        printf '%s%s' "$BITLOCKER_PROFILES" "$p"
    else
        printf '%s%s' "$HOST" "$p"
    fi
}

# resolved_folder <windows-user> <Folder> — host path to bind, or empty.
resolved_folder() {
    local wuser="$1" folder="$2" raw=""
    [[ -n "$KNOWN_FOLDERS" ]] || return 0
    command -v python3 >/dev/null || return 0
    raw=$(WOOTC_KF="$KNOWN_FOLDERS" WOOTC_USER="$wuser" WOOTC_FOLDER="$folder" \
        python3 -c 'import json,os,sys
try:
    d = json.load(open(os.environ["WOOTC_KF"]))
except Exception:
    sys.exit(0)
# The manifest describes ONE user. Using it for a different account would bind
# that account As redirected path into account Bs home.
if str(d.get("user","")).lower() != os.environ["WOOTC_USER"].lower():
    sys.exit(0)
print(d.get("folders", {}).get(os.environ["WOOTC_FOLDER"], ""))' 2>/dev/null || true)
    # MUST end 0: this runs under `set -Eeuo pipefail` inside a command
    # substitution, so returning non-zero for "no redirect" aborts the whole
    # bridge partway through the folder list — silently, because the folders
    # already bound look like a working migration.
    [[ -n "$raw" ]] && win_to_host "$raw"
    return 0
}

# A selected folder must not re-export the private installer tree or the
# entire Windows volume through a redirected path or symlink.
safe_folder_source() {
    local resolved root rlow low
    resolved=$(realpath -e -- "$1") || return 1
    root=$(realpath -e -- "$HOST") || return 1
    rlow="${resolved,,}"; low="${root,,}"
    case "$rlow" in
        "$low"|"$low/wootc"|"$low/wootc/"*) return 1 ;;
    esac
    # A user profile literally named wootc (C:\Users\wootc) lives under
    # Users/ — never confuse it with the installer tree. Deeper wootc
    # paths stay refused everywhere else on the volume.
    case "$rlow" in
        "$low/users/"*) ;;
        "$low/"*/wootc|"$low/"*/wootc/*) return 1 ;;
    esac
    [[ "$resolved" == "$root/"* ]] && return 0
    # The only alternate source is the volume this service unlocked itself.
    if [[ -n "${BITLOCKER_PROFILES:-}" ]]; then
        root=$(realpath -e -- "$BITLOCKER_PROFILES") || return 1
        [[ "$resolved" == "$root/"* ]] && return 0
    fi
    return 1
}

# Bind one Windows profile into one Linux home. Shared by the exact-name path
# and the single-user fallback so the two can never diverge.
bind_profile() {
    local winprofile="$1" luser="$2" home="$3" folder src dst
    if ! sel_on "$luser" files; then
        log "files: skipped for $luser (turned off in the migration chooser)"
        return 0
    fi
    # Windows folders can have mode0777 through NTFS. The Linux home is the
    # account boundary, including against a second local unprivileged user.
    [[ $(stat -Lc %u -- "$home") == "$(id -u "$luser")" ]] || return 1
    chmod 0700 -- "$home"
    for folder in "${FOLDERS[@]}"; do
        if command -v wootc-selection >/dev/null 2>&1; then
            local_item_rc=0
            wootc-selection "$luser" files "$folder" >/dev/null 2>&1 || local_item_rc=$?
            if [[ "$local_item_rc" -eq 1 ]]; then
                log "files/$folder: skipped (turned off in the migration chooser)"
                continue
            fi
        fi
        src="${winprofile}${folder}"
        # A redirected folder wins over the literal one — that is where the
        # user's files actually are. Only when it exists on this volume: a
        # manifest naming a path we cannot see must not cost us the default.
        redirected=$(resolved_folder "$(basename "${winprofile%/}")" "$folder")
        if [[ -n "$redirected" && -d "$redirected" && "$redirected" != "$src" ]]; then
            log "redirected: $folder -> $redirected (#64)"
            src="$redirected"
        fi
        dst="$home/$folder"
        # Every skip below used to be silent, which left "0 binds" with no
        # layer identified (run 20260928T061803Z: Documents/Pictures vanished
        # without a line). Say which gate fired for each folder.
        if [[ ! -d "$src" ]]; then
            log "files/$folder: no source dir ($src)"
            continue
        fi
        if ! safe_folder_source "$src"; then
            warn "refusing protected or invalid folder source: $src"
            continue
        fi
        # Converted to native storage (wootc-convert-dir) — stop bridging.
        if [[ -e "$home/.config/wootc/converted-$folder" ]]; then
            log "files/$folder: already converted to native storage"
            continue
        fi
        # Do not follow a user-created Documents symlink into another path.
        if [[ -L "$dst" ]]; then
            warn "refusing symlink folder destination: $dst"
            continue
        fi
        # BitLocker C: is intentionally mounted read-only. Copy Documents into the
        # user's persistent Linux home once so it can be edited without ever writing
        # through to the encrypted Windows source. Other folders remain passthroughs.
        if [[ "$folder" == Documents && -n "$BITLOCKER_PROFILES" && "$src" == "$BITLOCKER_PROFILES"/* ]]; then
            copy_helper=""
            if [[ -x /var/usrlocal/bin/wootc-copy-windows-documents ]]; then
                copy_helper=/var/usrlocal/bin/wootc-copy-windows-documents
            else
                copy_helper=$(command -v wootc-copy-windows-documents 2>/dev/null || true)
            fi
            if [[ -n "$copy_helper" ]] && "$copy_helper" "$src" "$home" "$luser" "$winprofile"; then
                copied=$((copied + 1))
                continue
            fi
            warn "Documents copy was not completed for $luser; keeping the original read-only"
        fi
        mkdir -p "$dst"
        if ! mountpoint -q "$dst"; then
            mount --bind "$src" "$dst"
            log "bound $src -> $dst"
            bound=$((bound + 1))
        else
            log "files/$folder: destination already mounted ($dst)"
        fi
    done
    add_host_bookmark "$home"
}

# A file-manager bookmark for everything OUTSIDE the six bridged folders
# (C:\Program Files, a games library, a second data directory). The bridged
# folders make the common files invisible magic; anything else was reachable
# only by typing /run/wootc/host, which no screen ever mentions (North Star
# audit 2026-08-22). One line per GTK generation, never duplicated, owned by
# the user (this unit runs as root). GTK bookmarks cover GNOME's Files and
# every GTK file dialog; Dolphin (KDE — Bazzite's file manager) reads
# user-places.xbel instead, so KDE gets its own entry below or the bookmark
# simply does not exist on half the catalog.
add_host_bookmark() {
    local home="$1" uri="file:///run/wootc/host Windows drive (read-only)" gen bm
    for gen in gtk-3.0 gtk-4.0; do
        bm="$home/.config/$gen/bookmarks"
        mkdir -p "${bm%/*}" 2>/dev/null || true
        if ! grep -qsF "$uri" "$bm" 2>/dev/null; then
            echo "$uri" >> "$bm" 2>/dev/null || true
        fi
        chown --reference="$home" "${bm%/*}" "$bm" 2>/dev/null || true
    done
    add_host_bookmark_kde "$home"
}

# KDE Places (Dolphin + KDE file dialogs): ~/.local/share/user-places.xbel.
# When the file does not exist yet (first login has not happened),
# KFilePlacesModel merges its standard system places into an existing file
# on first load, so seeding a minimal XBEL with only our entry is safe — the
# defaults still appear. When it exists, append the bookmark before the
# closing tag, never duplicated (keyed on the href).
add_host_bookmark_kde() {
    # Two statements: `local a=$1 b=$a/...` expands $a BEFORE the first
    # assignment lands, so xbel silently became "/.local/…" (filesystem root).
    local home="$1"
    local xbel="$home/.local/share/user-places.xbel"
    grep -qsF 'href="file:///run/wootc/host"' "$xbel" 2>/dev/null && return 0
    mkdir -p "${xbel%/*}" 2>/dev/null || true
    # No <bookmark:icon> element: the prefix is only bound when the target
    # file's root declares the freedesktop namespace, and an unbound prefix
    # makes the WHOLE places file unparseable — losing every place the user
    # has. KDE falls back to the folder icon; that is a fine trade.
    local entry=' <bookmark href="file:///run/wootc/host">
  <title>Windows drive (read-only)</title>
  <info>
   <metadata owner="http://www.kde.org">
    <ID>wootc-windows-drive</ID>
   </metadata>
  </info>
 </bookmark>'
    if [ -s "$xbel" ] && grep -qsF '</xbel>' "$xbel"; then
        # Insert before the closing tag with a temp-and-rename so a crash
        # mid-write can never leave a truncated places file behind.
        awk -v entry="$entry" '/<\/xbel>/{print entry} {print}' "$xbel" \
            > "$xbel.wootc-tmp" 2>/dev/null \
            && mv -f "$xbel.wootc-tmp" "$xbel" 2>/dev/null || rm -f "$xbel.wootc-tmp"
    else
        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
            '<!DOCTYPE xbel>' \
            '<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info" xmlns:kdepriv="http://www.kde.org/kdepriv">' \
            "$entry" \
            '</xbel>' > "$xbel" 2>/dev/null || true
    fi
    chown --reference="$home" "${xbel%/*}" "$xbel" 2>/dev/null || true
}

# Attempt BitLocker unlock before scanning for profiles when the host
# mount has no Users/ directory (the encrypted-C: signature, #61).
find_bitlocker_profiles

shopt -s nullglob
real_profiles=()
_profile_roots=()
[[ -d $HOST/Users ]] && _profile_roots+=("$HOST")
[[ -n "$BITLOCKER_PROFILES" ]] && _profile_roots+=("$BITLOCKER_PROFILES")
for _root in "${_profile_roots[@]}"; do
  for winprofile in "${_root}"/Users/*/ "${_root}"/*/Users/*/; do
    [[ -d "$winprofile" ]] || continue
    name=$(basename "$winprofile")
    case "$name" in
        Public|Default|"Default User"|"All Users") continue ;;
    esac
    real_profiles+=("$winprofile")

    # The installer records how each profile directory maps to the Linux
    # account it created (sanitization changes most names: "Alice Smith" is
    # account alice-smith, and the primary's chosen username need not resemble
    # their directory at all). Consult the map first; the exact directory-name
    # match stays as the fallback for deployments made before the map existed.
    account="$name"
    if [[ -r /etc/wootc/profile-map.tsv ]]; then
        mapped=$(awk -F'\t' -v k="$name" '$1 == k { print $2; exit }' \
            /etc/wootc/profile-map.tsv 2>/dev/null)
        if [[ -n "$mapped" ]]; then
            account="$mapped"
            [[ "$account" != "$name" ]] && log "profile map: $name -> $account"
        fi
    fi

    # Only bind for a Linux account that actually exists (skip unrelated
    # Windows profiles) and has UID >= 1000 (a real user, not a system account).
    uid=$(id -u "$account" 2>/dev/null) || continue
    [[ "$uid" -ge 1000 ]] || continue
    matched=$((matched + 1))

    home=$(getent passwd "$account" | cut -d: -f6)
    if [[ ! -d "$home" ]]; then
        # A matching account whose recorded home does not exist is a broken
        # deployment, not a skippable case — say so instead of exiting 0 in
        # silence (run 20260723T0423: fisherman's useradd left the home in
        # the deployment's masked var; this unit "succeeded" with 0 binds).
        log "ERROR: user $account has no home directory ($home) — cannot bridge; deployment bug"
        continue
    fi

    bind_profile "$winprofile" "$account" "$home"
  done
done

# Single-user fallback: one profile, one account, nothing matched by name.
if [[ "$matched" -eq 0 && "${#real_profiles[@]}" -eq 1 ]]; then
    mapfile -t linux_users < <(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { print $1 }')
    if [[ "${#linux_users[@]}" -eq 1 ]]; then
        fallback_user="${linux_users[0]}"
        fallback_home=$(getent passwd "$fallback_user" | cut -d: -f6)
        fallback_profile="${real_profiles[0]}"
        if [[ -d "$fallback_home" ]]; then
            log "no name match, but exactly one Windows profile ($(basename "$fallback_profile")) and one Linux user ($fallback_user) — bridging them (#73)"
            matched=1
            bind_profile "$fallback_profile" "$fallback_user" "$fallback_home"
        else
            log "ERROR: sole user $fallback_user has no home directory ($fallback_home) — cannot bridge"
        fi
    else
        log "no name match and ${#linux_users[@]} Linux users — cannot decide whose data this is; leaving unbridged"
    fi
fi
shopt -u nullglob
# Always leave a verdict in the journal: "Finished" alone cannot distinguish
# a bridged home from a run where every profile was silently skipped.
log "summary: $bound folder binds and $copied persistent copies across $matched matching user(s)"

# Steam category (best-effort — never fail the mount service over it).
if command -v wootc-steam-bridge >/dev/null && sel_on "${SUDO_USER:-root}" games; then
    wootc-steam-bridge || log "steam bridge reported an error (non-fatal)"
elif command -v wootc-steam-bridge >/dev/null; then
    log "games: skipped (turned off in the migration chooser)"
fi

# Cloud-drive disclosure (#66). The Phase-1 installer records which cloud
# providers are on this machine; the bridge states them in the journal so
# the user knows what to expect. Google Drive in particular lives at a
# virtual drive letter (G:) produced by DriveFS at runtime — there is
# nothing on the physical disk to bridge, and a mount is the only route
# to content.
CLOUD_DRIVES=""
for candidate in "$HOST"/wootc/cloud-drives.json "$HOST"/*/wootc/cloud-drives.json; do
    [[ -f "$candidate" ]] && { CLOUD_DRIVES="$candidate"; break; }
done
if [[ -n "$CLOUD_DRIVES" ]]; then
    log "cloud providers detected:"
    python3 -c '
import json,sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for c in d.get("drives", []):
    p = c.get("provider","?")
    a = c.get("account", "?")
    r = c.get("rootPath", "")
    v = "virtual" if c.get("virtualDrive") else "folder"
    n = c.get("note", "")
    lbl = f"  {p} ({a}): {r} [{v}]"
    if n:
        lbl += f" — {n}"
    print(lbl)
' "$CLOUD_DRIVES" 2>/dev/null || true
fi

# App-data bridge: per-user detection + portable-state copy (best-effort).
if command -v wootc-detect-apps >/dev/null; then
    # The Linux account name is not guaranteed to equal the Windows profile
    # directory. Prefer an explicit dashboard mapping, then an exact match,
    # then the sole discovered profile. This keeps app and Office bridges on
    # the same profile mapping as the folder bridge.
    profile_for_linux() {
        local linuxuser="$1" home mapped candidate
        home=$(getent passwd "$linuxuser" | cut -d: -f6)
        mapped=""
        if command -v jq >/dev/null && [[ -f "$home/.config/wootc/profile-map.json" ]]; then
            mapped=$(jq -r '.windowsProfile // empty' "$home/.config/wootc/profile-map.json" 2>/dev/null || true)
        fi
        if [[ -n "$mapped" ]]; then
            for candidate in "${real_profiles[@]}"; do
                [[ "$(basename "$candidate")" == "$mapped" ]] && { basename "$candidate"; return 0; }
            done
        fi
        for candidate in "${real_profiles[@]}"; do
            [[ "$(basename "$candidate")" == "$linuxuser" ]] && { basename "$candidate"; return 0; }
        done
        if [[ "${#real_profiles[@]}" -eq 1 ]]; then
            basename "${real_profiles[0]}"
        fi
    }

    shopt -s nullglob
    for userhome in /home/*/; do
        uname=$(basename "$userhome")
        uid=$(id -u "$uname" 2>/dev/null) || continue
        [[ "$uid" -ge 1000 ]] || continue
        winuser=$(profile_for_linux "$uname")
        if [[ -z "$winuser" ]]; then
            log "no Windows profile mapped for $uname; skipping app/Office bridge"
            continue
        fi
        wootc-detect-apps "$winuser" "$uname" || log "app detection failed for $winuser → $uname (non-fatal)"
        if command -v wootc-office-bridge >/dev/null; then
            if sel_on "$uname" office; then
                wootc-office-bridge "$winuser" "$uname" || log "office bridge failed for $winuser → $uname (non-fatal)"
            else
                log "office: skipped for $uname (turned off in the migration chooser)"
            fi
        fi
        # Copy the account picture + full name over (never the password).
        if command -v wootc-identity >/dev/null; then
            if sel_on "$uname" identity; then
                wootc-identity apply "$winuser" "$uname" >/dev/null || log "identity copy failed for $winuser → $uname (non-fatal)"
            else
                log "identity: skipped for $uname (turned off in the migration chooser)"
            fi
        fi
    done
    shopt -u nullglob
fi

# ── BitLocker cleanup (#61) ──────────────────────────────────────────────
# The encrypted C: was mounted temporarily for profile discovery. Unmount
# and lock it now that the binds are established (bind mounts keep
# individual file handles alive, so the profiles remain readable even after
# the underlying NTFS mount is gone, but the binds point at the mount tree
# so they must stay — just leave a note that cleanup happens at shutdown).
if [[ -n "$BITLOCKER_PROFILES" ]]; then
    log "BitLocker volume ${BITLOCKER_PROFILES} will be unmounted at shutdown (wootc-umount-user-dirs)"
fi

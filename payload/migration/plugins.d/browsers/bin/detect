#!/usr/bin/env python3
"""Adapt plugin discovery to the authoritative, read-only app detector."""
import os
from pathlib import Path
import shutil
import sys

# Bundled checkouts and installed /usr/lib/wootc plugins share the same entry
# point; never fall back to a second implementation of browser detection.
bundled = Path(__file__).resolve().parents[3] / "wootc-detect-apps"
detector = str(bundled) if bundled.is_file() else shutil.which("wootc-detect-apps")
if not detector:
    print("[browsers] wootc-detect-apps is not installed", file=sys.stderr)
    sys.exit(1)
os.execv(detector, [detector, "--detect-browsers"])

#!/usr/bin/env bash
set -Eeuo pipefail

WIN_USER="${WOOTC_WIN_USER:-}"
LINUX_USER="${WOOTC_LINUX_USER:-${USER:-}}"
STATE_DIR="${WOOTC_STATE_DIR:-${WOOTC_LINUX_HOME:-$HOME}/.config/wootc}"
exec python3 "$(dirname "${BASH_SOURCE[0]}")/../../import-result.py" \
    --state-dir "$STATE_DIR" --require-source-user wootc-identity apply "$WIN_USER" "$LINUX_USER"
